SwitchTab("Home")

Win.BackgroundTransparency=1; Win.Size=UDim2.new(0,830,0,0)
Tw(Win,{BackgroundTransparency=0,Size=UDim2.new(0,830,0,530)},0.35,
    Enum.EasingStyle.Back, Enum.EasingDirection.Out)

