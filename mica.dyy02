    CrossThick    = 1,
    FPSCounter    = false,
    PerfMon       = false,
    -- Settings
    MenuKey       = Enum.KeyCode.Insert,
    UIScale       = 1,
    Animations    = true,
    Sounds        = false,
    Language      = "PT-BR",
}

-- ============================================================
-- THEME
-- ============================================================
local T = {
    BG      = Color3.fromRGB(8,   8,   8),
    BG2     = Color3.fromRGB(14,  14,  14),
    Card    = Color3.fromRGB(18,  18,  18),
    Side    = Color3.fromRGB(10,  10,  10),
    Acc     = Color3.fromRGB(150, 59,  255),
    AccL    = Color3.fromRGB(183, 122, 255),
    AccD    = Color3.fromRGB(40,  15,  80),
    White   = Color3.fromRGB(255, 255, 255),
    Sub     = Color3.fromRGB(120, 120, 130),
    Border  = Color3.fromRGB(32,  32,  40),
    OK      = Color3.fromRGB(0,   210, 90),
    Err     = Color3.fromRGB(255, 55,  55),
}

-- ============================================================
-- UTILITIES
-- ============================================================
local function New(cls, props, parent)
    local i = Instance.new(cls)
    for k, v in pairs(props or {}) do
        pcall(function() i[k] = v end)
    end
    if parent then i.Parent = parent end
    return i
end

local function Tw(obj, goal, t, s, d)
    TweenService:Create(obj,
        TweenInfo.new(t or 0.18,
            s or Enum.EasingStyle.Quart,
            d or Enum.EasingDirection.Out),
        goal):Play()
end

local function Corner(p, r)
    return New("UICorner", {CornerRadius = UDim.new(0, r or 6)}, p)
end

local function Stroke(p, col, th)
    return New("UIStroke", {Color = col or T.Border, Thickness = th or 1}, p)
end

local function Pad(p, t, r, b, l)
    New("UIPadding", {
        PaddingTop    = UDim.new(0, t or 8),
        PaddingRight  = UDim.new(0, r or 8),
        PaddingBottom = UDim.new(0, b or 8),
        PaddingLeft   = UDim.new(0, l or 8),
    }, p)
end

local function List(p, gap)
    return New("UIListLayout", {
        Padding             = UDim.new(0, gap or 8),
        FillDirection       = Enum.FillDirection.Vertical,
        SortOrder           = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
    }, p)
end

local function MkScroll(parent)
    local s = New("ScrollingFrame", {
        Size                   = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        ScrollBarThickness     = 3,
        ScrollBarImageColor3   = T.Acc,
        CanvasSize             = UDim2.new(0, 0, 0, 0),
        ScrollingDirection     = Enum.ScrollingDirection.Y,
    }, parent)
    local l = List(s, 10)
    l:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        s.CanvasSize = UDim2.new(0, 0, 0, l.AbsoluteContentSize.Y + 20)
    end)
    Pad(s, 6, 6, 10, 2)
    return s
end

-- ============================================================
-- NOTIFICATIONS
-- ============================================================
local NotifHolder

local function Notif(title, msg, ntype)
    if not NotifHolder then return end
    local col = ntype == "success" and T.OK or ntype == "error" and T.Err or T.Acc
    local n = New("Frame", {
        Size             = UDim2.new(1, 0, 0, 62),
        BackgroundColor3 = T.Card,
        BackgroundTransparency = 0.08,
    }, NotifHolder)
    Corner(n, 6); Stroke(n, col, 1)
    New("Frame", {
        Size             = UDim2.new(0, 3, 1, -10),
        Position         = UDim2.new(0, 0, 0, 5),
        BackgroundColor3 = col,
    }, n)
    New("TextLabel", {
        Size               = UDim2.new(1,-14, 0, 18),
        Position           = UDim2.new(0, 10, 0, 8),
        BackgroundTransparency = 1,
        Text               = title, TextColor3 = T.White,
        Font               = Enum.Font.GothamBold, TextSize = 12,
        TextXAlignment     = Enum.TextXAlignment.Left,
    }, n)
    New("TextLabel", {
        Size               = UDim2.new(1,-14, 0, 28),
        Position           = UDim2.new(0, 10, 0, 28),
        BackgroundTransparency = 1,
        Text               = msg, TextColor3 = T.Sub,
        Font               = Enum.Font.Gotham, TextSize = 11,
        TextXAlignment     = Enum.TextXAlignment.Left, TextWrapped = true,
    }, n)
    Tw(n, {BackgroundTransparency = 0}, 0.2)
    task.delay(3.5, function()
        Tw(n, {BackgroundTransparency = 1}, 0.3)
        task.wait(0.35); pcall(function() n:Destroy() end)
    end)
end

-- ============================================================
-- UI COMPONENTS
-- ============================================================

-- Card
local function Card(parent, title, order)
    local c = New("Frame", {
        Size             = UDim2.new(1, 0, 0, 10),
        BackgroundColor3 = T.Card,
        LayoutOrder      = order or 0,
    }, parent)
    Corner(c, 8); Stroke(c, T.Border, 1)
    if title then
        New("TextLabel", {
            Size               = UDim2.new(1,-16, 0, 28),
            Position           = UDim2.new(0, 8, 0, 6),
            BackgroundTransparency = 1,
            Text               = title, TextColor3 = T.AccL,
            Font               = Enum.Font.GothamBold, TextSize = 11,
            TextXAlignment     = Enum.TextXAlignment.Left,
        }, c)
        New("Frame", {
            Size             = UDim2.new(1,-16, 0, 1),
            Position         = UDim2.new(0, 8, 0, 34),
            BackgroundColor3 = T.Border,
        }, c)
    end
    local inner = New("Frame", {
        Size             = UDim2.new(1,-16, 0, 0),
        Position         = UDim2.new(0, 8, 0, title and 40 or 8),
        BackgroundTransparency = 1,
    }, c)
    local l = List(inner, 8)
    local function upd()
        local h = l.AbsoluteContentSize.Y
        inner.Size = UDim2.new(1,-16, 0, h)
        c.Size     = UDim2.new(1, 0, 0, h + (title and 48 or 16))
    end
    l:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(upd); upd()
    return c, inner
end

-- Toggle
local function Toggle(parent, label, default, cb, order)
    local on = default or false
    local row = New("Frame", {
        Size             = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
        LayoutOrder      = order or 0,
    }, parent)
    New("TextLabel", {
        Size               = UDim2.new(1,-54, 1, 0),
        BackgroundTransparency = 1,
        Text               = label, TextColor3 = T.White,
        Font               = Enum.Font.Gotham, TextSize = 12,
        TextXAlignment     = Enum.TextXAlignment.Left,
    }, row)
    local track = New("Frame", {
        Size             = UDim2.new(0, 42, 0, 22),
        Position         = UDim2.new(1,-42, 0.5,-11),
        BackgroundColor3 = on and T.Acc or Color3.fromRGB(38,38,48),
    }, row)
    Corner(track, 11)
    local knob = New("Frame", {
        Size             = UDim2.new(0, 16, 0, 16),
        Position         = on and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8),
        BackgroundColor3 = T.White,
    }, track)
    Corner(knob, 8)
    local btn = New("TextButton", {
        Size = UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="",
    }, row)
    btn.MouseButton1Click:Connect(function()
        on = not on
        Tw(track, {BackgroundColor3 = on and T.Acc or Color3.fromRGB(38,38,48)}, 0.15)
        Tw(knob,  {Position = on and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8)}, 0.15)
        if cb then pcall(cb, on) end
    end)
    local function set(v) on=v
        Tw(track, {BackgroundColor3=on and T.Acc or Color3.fromRGB(38,38,48)},0.15)
        Tw(knob,  {Position=on and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8)},0.15)
    end
    return row, function() return on end, set
end

-- Slider
local function Slider(parent, label, min, max, default, cb, suffix, order)
    suffix = suffix or ""
    local val = math.clamp(default or min, min, max)
    local dragging = false
    local row = New("Frame", {
        Size=UDim2.new(1,0,0,52), BackgroundTransparency=1, LayoutOrder=order or 0,
    }, parent)
    New("TextLabel", {
        Size=UDim2.new(0.72,0,0,20), BackgroundTransparency=1,
        Text=label, TextColor3=T.White, Font=Enum.Font.Gotham, TextSize=12,
        TextXAlignment=Enum.TextXAlignment.Left,
    }, row)
    local vl = New("TextLabel", {
        Size=UDim2.new(0.28,0,0,20), Position=UDim2.new(0.72,0,0,0),
        BackgroundTransparency=1,
        Text=tostring(val)..suffix, TextColor3=T.Acc,
        Font=Enum.Font.GothamBold, TextSize=12,
        TextXAlignment=Enum.TextXAlignment.Right,
    }, row)
    local track = New("Frame", {
        Size=UDim2.new(1,0,0,4), Position=UDim2.new(0,0,0,26),
        BackgroundColor3=T.Border,
    }, row)
    Corner(track, 2)
    local r0 = math.clamp((val-min)/(max-min),0,1)
    local fill = New("Frame", {Size=UDim2.fromScale(r0,1), BackgroundColor3=T.Acc}, track)
    Corner(fill, 2)
    local handle = New("Frame", {
        Size=UDim2.fromOffset(12,12), Position=UDim2.new(r0,-6,0.5,-6),
        BackgroundColor3=T.AccL,
    }, track)
    Corner(handle, 6)
    local hb = New("TextButton", {
        Size=UDim2.new(1,0,0,20), Position=UDim2.new(0,0,0.5,-10),
        BackgroundTransparency=1, Text="",
    }, track)
    local function apply(x)
        local a=track.AbsolutePosition.X; local s=track.AbsoluteSize.X
        if s<=0 then return end
        local r=math.clamp((x-a)/s,0,1)
        val=math.floor(min+(max-min)*r+0.5)
        fill.Size=UDim2.fromScale(r,1)
        handle.Position=UDim2.new(r,-6,0.5,-6)
        vl.Text=tostring(val)..suffix
        if cb then pcall(cb,val) end
    end
    hb.MouseButton1Down:Connect(function(x) dragging=true; apply(x) end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then apply(i.Position.X) end
    end)
    return row
end

-- Dropdown
local function Dropdown(parent, label, opts, default, cb, order)
    local sel = default or opts[1]
    local open = false
    local row = New("Frame", {
        Size=UDim2.new(1,0,0,32), BackgroundTransparency=1,
        LayoutOrder=order or 0, ClipsDescendants=false, ZIndex=3,
    }, parent)
    New("TextLabel", {
        Size=UDim2.new(0.5,0,1,0), BackgroundTransparency=1,
        Text=label, TextColor3=T.White, Font=Enum.Font.Gotham, TextSize=12,
        TextXAlignment=Enum.TextXAlignment.Left,
    }, row)
    local btn = New("TextButton", {
        Size=UDim2.new(0.48,0,0,26), Position=UDim2.new(0.52,0,0.5,-13),
        BackgroundColor3=T.BG2, Text=sel, TextColor3=T.AccL,
        Font=Enum.Font.GothamBold, TextSize=11,
    }, row)
    Corner(btn,4); Stroke(btn, T.Border, 1)
    New("TextLabel", {
        Size=UDim2.new(0,14,1,0), Position=UDim2.new(1,-16,0,0),
        BackgroundTransparency=1, Text="▾", TextColor3=T.Sub, TextSize=10,
    }, btn)
    local dd = New("Frame", {
        Size=UDim2.new(0.48,0,0,#opts*26+4),
        Position=UDim2.new(0.52,0,0,34),
        BackgroundColor3=T.BG2, Visible=false, ZIndex=12,
    }, row)
    Corner(dd,4); Stroke(dd, T.Border, 1); Pad(dd,2,0,2,0)
    local ddl = List(dd, 0)
    for _, opt in ipairs(opts) do
        local it = New("TextButton", {
            Size=UDim2.new(1,0,0,24),
            BackgroundColor3=opt==sel and T.AccD or Color3.fromRGB(0,0,0),
            BackgroundTransparency=opt==sel and 0 or 1,
            Text=opt, TextColor3=opt==sel and T.AccL or T.White,
            Font=Enum.Font.Gotham, TextSize=11, ZIndex=13,
        }, dd)
        Corner(it, 3)
        it.MouseButton1Click:Connect(function()
            sel=opt; btn.Text=opt; open=false; dd.Visible=false
            if cb then pcall(cb,opt) end
        end)
        it.MouseEnter:Connect(function()
            if opt~=sel then Tw(it,{BackgroundTransparency=0,BackgroundColor3=Color3.fromRGB(28,28,38)},0.1) end
        end)
        it.MouseLeave:Connect(function()
            if opt~=sel then Tw(it,{BackgroundTransparency=1},0.1) end
        end)
    end
    btn.MouseButton1Click:Connect(function() open=not open; dd.Visible=open end)
    return row
end

-- Keybind
local function Keybind(parent, label, default, cb, order)
    local key = default; local cap = false
    local row = New("Frame", {
        Size=UDim2.new(1,0,0,32), BackgroundTransparency=1, LayoutOrder=order or 0,
    }, parent)
    New("TextLabel", {
        Size=UDim2.new(0.55,0,1,0), BackgroundTransparency=1,
        Text=label, TextColor3=T.White, Font=Enum.Font.Gotham, TextSize=12,
        TextXAlignment=Enum.TextXAlignment.Left,
    }, row)
    local function kn(k) return tostring(k):gsub("Enum.KeyCode.",""):gsub("Enum.UserInputType.","") end
    local kb = New("TextButton", {
        Size=UDim2.new(0.43,0,0,24), Position=UDim2.new(0.57,0,0.5,-12),
        BackgroundColor3=T.BG2, Text=kn(key), TextColor3=T.AccL,
        Font=Enum.Font.GothamBold, TextSize=11,
    }, row)
    Corner(kb,4); Stroke(kb, T.Border, 1)
    kb.MouseButton1Click:Connect(function()
        if cap then return end; cap=true
        kb.Text="[ ... ]"; kb.TextColor3=T.Acc
    end)
    UserInputService.InputBegan:Connect(function(inp, gpe)
        if not cap then return end; cap=false
        if inp.KeyCode~=Enum.KeyCode.Unknown then key=inp.KeyCode end
        kb.Text=kn(key); kb.TextColor3=T.AccL
        if cb then pcall(cb,key) end
    end)
    return row
end

-- Section divider
local function Sec(parent, text, order)
    local f = New("Frame", {
        Size=UDim2.new(1,0,0,24), BackgroundTransparency=1, LayoutOrder=order or 0,
    }, parent)
    New("TextLabel", {
        Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
        Text=text, TextColor3=T.Acc, Font=Enum.Font.GothamBold, TextSize=9,
        TextXAlignment=Enum.TextXAlignment.Left,
    }, f)
    New("Frame", {
        Size=UDim2.new(1,0,0,1), Position=UDim2.new(0,0,1,-1),
        BackgroundColor3=T.Border,
    }, f)
    return f
end

