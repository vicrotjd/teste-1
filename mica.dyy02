        Size=UDim2.new(1,0,0,34),
        BackgroundColor3=Color3.fromRGB(28,8,8),
        Text="⚠  PANIC — DESATIVAR TUDO",
        TextColor3=T.Err, Font=Enum.Font.GothamBold, TextSize=12,
        LayoutOrder=1,
    },c3)
    Corner(panic,6); Stroke(panic,T.Err,1)
    panic.MouseButton1Click:Connect(function()
        CFG.AimEnabled=false; CFG.ESPEnabled=false; CFG.FlyEnabled=false
