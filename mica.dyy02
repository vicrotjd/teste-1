    Size=UDim2.new(1,-68,1,-60), Position=UDim2.new(0,62,0,55),
    BackgroundTransparency=1, ClipsDescendants=true,
}, Win)

-- ============================================================
-- TABS
-- ============================================================
local function MakeTab(id)
    local f = New("Frame", {
        Name="Tab_"..id,
        Size=UDim2.new(1,0,1,0),
        BackgroundTransparency=1,
        Visible=false,
    }, CA)
    TabFrames[id] = f
    return f
end

-- ============================================================
-- TAB: HOME
-- ============================================================
do
    local tab = MakeTab("Home")
    local scr = MkScroll(tab)

    local banner = New("Frame", {Size=UDim2.new(1,0,0,92), BackgroundColor3=T.Card}, scr)
    Corner(banner,8)
    New("Frame",{Size=UDim2.new(1,0,0,3),BackgroundColor3=T.Acc},banner)
    New("TextLabel",{
        Size=UDim2.new(1,-20,0,34),Position=UDim2.new(0,14,0,10),
        BackgroundTransparency=1,Text="MICA.DYY",TextColor3=T.AccL,
        Font=Enum.Font.GothamBlack,TextSize=26,
        TextXAlignment=Enum.TextXAlignment.Left,
    },banner)
    New("TextLabel",{
        Size=UDim2.new(1,-20,0,18),Position=UDim2.new(0,14,0,46),
        BackgroundTransparency=1,Text="Advanced Gaming Panel — Global Script v2.0",
        TextColor3=T.Sub,Font=Enum.Font.Gotham,TextSize=12,
        TextXAlignment=Enum.TextXAlignment.Left,
    },banner)
    New("TextLabel",{
        Size=UDim2.new(1,-20,0,14),Position=UDim2.new(0,14,0,68),
        BackgroundTransparency=1,
        Text="Insert = menu  ·  C = aimbot  ·  Executor Compatible",
        TextColor3=T.Acc,Font=Enum.Font.GothamBold,TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left,
    },banner)

    -- Stats
    local stats = {
        {"JOGO",     game.Name~="" and game.Name or "Roblox"},
        {"JOGADOR",  LP and LP.Name or "Unknown"},
        {"PLACE ID", tostring(game.PlaceId)},
        {"STATUS",   "ATIVO"},
    }
    local sg = New("Frame",{Size=UDim2.new(1,0,0,80),BackgroundTransparency=1},scr)
    local gl = New("UIGridLayout",{
        CellSize=UDim2.new(0.5,-5,0,34),
        CellPaddingSize=UDim2.new(0,8,0,8),
        SortOrder=Enum.SortOrder.LayoutOrder,
    },sg)
    gl:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        sg.Size=UDim2.new(1,0,0,gl.AbsoluteContentSize.Y)
    end)
    for i,s in ipairs(stats) do
        local sc=New("Frame",{BackgroundColor3=T.Card,LayoutOrder=i},sg)
        Corner(sc,6);Stroke(sc,T.Border,1)
        New("TextLabel",{
            Size=UDim2.new(1,-10,0,12),Position=UDim2.new(0,6,0,4),
            BackgroundTransparency=1,Text=s[1],TextColor3=T.Sub,
            Font=Enum.Font.GothamBold,TextSize=8,
            TextXAlignment=Enum.TextXAlignment.Left,
        },sc)
        New("TextLabel",{
            Size=UDim2.new(1,-10,0,16),Position=UDim2.new(0,6,0,16),
            BackgroundTransparency=1,Text=s[2],TextColor3=T.White,
            Font=Enum.Font.Gotham,TextSize=11,
            TextXAlignment=Enum.TextXAlignment.Left,
            TextTruncate=Enum.TextTruncate.AtEnd,
        },sc)
    end

    local _,qc=Card(scr,"ATIVAÇÃO RÁPIDA")
    Toggle(qc,"Aimbot",        CFG.AimEnabled,  function(v) CFG.AimEnabled =v end)
    Toggle(qc,"ESP / Visuals", CFG.ESPEnabled,  function(v) CFG.ESPEnabled =v end)
    Toggle(qc,"Fly Mode",      CFG.FlyEnabled,  function(v) CFG.FlyEnabled =v end)
end

