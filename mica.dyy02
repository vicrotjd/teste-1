-- Force Currency | Universal Brute
-- Tenta todos os remotes relacionados a reward/moeda
-- Monitora qual causa mudança e spama ele

local Players = game:GetService("Players")
local plr = Players.LocalPlayer
local kw = {"spin","luck","reward","coin","currency","claim","mission","give","money","token","prize","daily","chest","task","complete","finish","collect","purchase","grant","add"}

-- Argumentos comuns que jogos usam em eventos de reward
local commonArgs = {
    {},
    {true},
    {1},
    {"claim"},
    {"complete"},
    {"reward"},
    {"daily"},
    {plr.Name},
    {plr.UserId},
    {true, 1},
    {"claim", 1},
    {"complete", true},
}

-- Coleta todos os values do player como baseline
local function getValues()
    local snap = {}
    for _, v in ipairs(plr:GetDescendants()) do
        if v:IsA("IntValue") or v:IsA("NumberValue") then
            snap[v:GetFullName()] = v.Value
        end
    end
    return snap
end

local function diffValues(before, after)
    local changed = {}
    for k, v in pairs(after) do
        if before[k] and after[k] ~= before[k] then
            table.insert(changed, k .. ": " .. tostring(before[k]) .. " -> " .. tostring(after[k]))
        end
    end
    return changed
end

-- Filtra remotes por keyword
local targets = {}
for _, v in ipairs(game:GetDescendants()) do
    if v:IsA("RemoteEvent") then
        local lower = v.Name:lower()
        for _, k in ipairs(kw) do
            if lower:find(k) then
                table.insert(targets, v)
                warn("[TARGET] " .. v:GetFullName())
                break
            end
        end
    end
end

if #targets == 0 then
    warn("[!] Nenhum remote encontrado com keywords. Tentando TODOS os remotes...")
    for _, v in ipairs(game:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            table.insert(targets, v)
        end
    end
end

warn("[Scanner] " .. #targets .. " remotes alvo. Iniciando brute...")

-- Fase 1: probe — descobre qual remote muda valor
local hitRemote = nil
local hitArgs   = nil

for _, remote in ipairs(targets) do
    for _, args in ipairs(commonArgs) do
        local before = getValues()
        pcall(function()
            remote:FireServer(table.unpack(args))
        end)
        task.wait(0.3)
        local after = getValues()
        local diff = diffValues(before, after)
        if #diff > 0 then
            warn("[HIT] Remote: " .. remote:GetFullName())
            for _, d in ipairs(diff) do warn("  " .. d) end
            hitRemote = remote
            hitArgs   = args
            break
        end
    end
    if hitRemote then break end
    task.wait(0.1)
end

-- Fase 2: farm — spama o remote que funcionou
if hitRemote then
    warn("[FARM] Iniciando farm em: " .. hitRemote:GetFullName())
    while task.wait(1) do
        pcall(function()
            for i = 1, 3 do
                hitRemote:FireServer(table.unpack(hitArgs))
                task.wait(0.05)
            end
        end)
        local snap = getValues()
        for k, v in pairs(snap) do
            if k:lower():find("spin") or k:lower():find("luck") or k:lower():find("coin") or k:lower():find("token") then
                warn("[VALOR ATUAL] " .. k .. " = " .. tostring(v))
            end
        end
    end
else
    warn("[FAIL] Nenhum remote causou mudança de valor.")
    warn("Manda o output completo dos remotes pro ANON.")
    -- Lista tudo pra análise manual
    for _, v in ipairs(game:GetDescendants()) do
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            print(v:GetFullName())
        end
    end
end
