-- VL Scanner v2 | Xeno
local kw = {"spin","luck","reward","coin","currency","claim","mission","give","money","token","prize","daily","chest","task","complete","finish","purchase"}

local function match(name)
    name = name:lower()
    for _, k in ipairs(kw) do
        if name:find(k) then return true end
    end
    return false
end

-- REMOTES
warn("===== REMOTES RELEVANTES =====")
local total = 0
for _, v in ipairs(game:GetDescendants()) do
    if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
        total = total + 1
        if match(v.Name) then
            warn(">> " .. v.ClassName .. " | " .. v:GetFullName())
        end
    end
end
warn("Total de remotes encontrados: " .. total)

-- TODOS OS REMOTES (caso nenhum keyword bata)
warn("===== TODOS OS REMOTES =====")
for _, v in ipairs(game:GetDescendants()) do
    if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
        print(v.ClassName .. " | " .. v:GetFullName())
    end
end

-- PLAYER VALUES
warn("===== PLAYER VALUES =====")
local plr = game.Players.LocalPlayer
for _, v in ipairs(plr:GetDescendants()) do
    if v:IsA("IntValue") or v:IsA("NumberValue") or v:IsA("StringValue") or v:IsA("BoolValue") then
        print(v.Name .. " = " .. tostring(v.Value) .. "  [" .. v:GetFullName() .. "]")
    end
end

warn("===== FIM =====")
