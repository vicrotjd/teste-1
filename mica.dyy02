-- ============================================================
-- NAVIGATION
-- ============================================================
local function SwitchTab(id)
    TabLbl.Text = id:upper()
    for tid, f in pairs(TabFrames) do
        if tid==id then
            f.Visible=true
            if CFG.Animations then
                f.Position=UDim2.new(0.04,0,0,0)
                Tw(f,{Position=UDim2.new(0,0,0,0)},0.16)
            end
        else f.Visible=false end
    end
    for _,d in ipairs(NavBtns) do
        local a=d.id==id
        Tw(d.bg,{BackgroundColor3=a and T.AccD or Color3.fromRGB(0,0,0),
            BackgroundTransparency=a and 0 or 1},0.15)
        d.icon.TextColor3 = a and T.Acc  or T.Sub
        d.lbl.TextColor3  = a and T.AccL or T.Sub
        Tw(d.bar,{BackgroundTransparency=a and 0 or 1},0.15)
    end
end

for _,nd in ipairs(NavData) do
    local btn=New("TextButton",{
        Size=UDim2.new(1,0,0,48), BackgroundTransparency=1, Text="",
    },NH)
    local bg=New("Frame",{
        Size=UDim2.new(1,-8,1,-6), Position=UDim2.new(0,4,0,3),
        BackgroundColor3=T.AccD, BackgroundTransparency=1,
    },btn); Corner(bg,6)
    local bar=New("Frame",{
        Size=UDim2.new(0,3,0.55,0), Position=UDim2.new(0,0,0.225,0),
        BackgroundColor3=T.Acc, BackgroundTransparency=1,
    },btn); Corner(bar,2)
    local icon=New("TextLabel",{
        Size=UDim2.new(1,0,0,22), Position=UDim2.new(0,0,0,5),
        BackgroundTransparency=1, Text=nd.icon,
        TextColor3=T.Sub, Font=Enum.Font.GothamBold, TextSize=16,
    },btn)
    local lbl=New("TextLabel",{
        Size=UDim2.new(1,0,0,13), Position=UDim2.new(0,0,0,26),
        BackgroundTransparency=1, Text=nd.label:upper(),
        TextColor3=T.Sub, Font=Enum.Font.GothamBold, TextSize=7,
    },btn)
    NavBtns[#NavBtns+1]={id=nd.id,bg=bg,bar=bar,icon=icon,lbl=lbl}
    btn.MouseButton1Click:Connect(function() SwitchTab(nd.id) end)
    btn.MouseEnter:Connect(function()
        if nd.id~=TabLbl.Text:lower() then Tw(icon,{TextColor3=T.White},0.1) end
    end)
    btn.MouseLeave:Connect(function()
        if nd.id~=TabLbl.Text:lower() then Tw(icon,{TextColor3=T.Sub},0.1) end
    end)
end

-- ============================================================
-- DRAG
-- ============================================================
do
    local drag,ds,dp=false
    Hdr.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then
            drag=true; ds=i.Position; dp=Win.Position
        end
    end)
    Hdr.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and i.UserInputType==Enum.UserInputType.MouseMovement then
            local d=i.Position-ds
            Win.Position=UDim2.new(dp.X.Scale,dp.X.Offset+d.X,dp.Y.Scale,dp.Y.Offset+d.Y)
        end
    end)
end

-- ============================================================
-- WINDOW CONTROLS
-- ============================================================
local minimized=false
local wOrig=Win.Size

MinBtn.MouseButton1Click:Connect(function()
    minimized=not minimized
    if minimized then
        CA.Visible=false; Tw(Win,{Size=UDim2.new(0,830,0,50)},0.2)
    else
        Tw(Win,{Size=wOrig},0.2); task.wait(0.22); CA.Visible=true
    end
end)
CloseBtn.MouseButton1Click:Connect(function()
    Tw(Win,{Size=UDim2.new(0,830,0,0),BackgroundTransparency=1},0.2)
    task.wait(0.25); SG:Destroy()
end)

for _,b in ipairs({MinBtn,CloseBtn}) do
    b.MouseEnter:Connect(function()
        Tw(b,{BackgroundColor3=b==CloseBtn and Color3.fromRGB(50,15,15) or Color3.fromRGB(30,30,40)},0.1)
    end)
    b.MouseLeave:Connect(function()
        Tw(b,{BackgroundColor3=b==CloseBtn and Color3.fromRGB(30,10,10) or T.BG2},0.1)
    end)
end

-- ============================================================
-- ESP — DRAWING BASED
-- ============================================================
local ESP = {}

local function mkLine(props)
    local l=Drawing.new("Line")
    for k,v in pairs(props or {}) do pcall(function() l[k]=v end) end
    return l
end
local function mkText(props)
    local t=Drawing.new("Text")
    for k,v in pairs(props or {}) do pcall(function() t[k]=v end) end
    return t
end
local function mkSquare(props)
    local s=Drawing.new("Square")
    for k,v in pairs(props or {}) do pcall(function() s[k]=v end) end
    return s
end
local function mkCircle(props)
    local c=Drawing.new("Circle")
    for k,v in pairs(props or {}) do pcall(function() c[k]=v end) end
    return c
end

local function getESPObj(player)
    if ESP[player] then return ESP[player] end
    local o = {
        -- Box 4 lines
        bT=mkLine({Thickness=1.5,Visible=false}),
        bB=mkLine({Thickness=1.5,Visible=false}),
        bL=mkLine({Thickness=1.5,Visible=false}),
        bR=mkLine({Thickness=1.5,Visible=false}),
        -- Corner box (8 segments)
        cTL1=mkLine({Thickness=2,Visible=false}), cTL2=mkLine({Thickness=2,Visible=false}),
        cTR1=mkLine({Thickness=2,Visible=false}), cTR2=mkLine({Thickness=2,Visible=false}),
        cBL1=mkLine({Thickness=2,Visible=false}), cBL2=mkLine({Thickness=2,Visible=false}),
        cBR1=mkLine({Thickness=2,Visible=false}), cBR2=mkLine({Thickness=2,Visible=false}),
        -- Health
        hpBG=mkSquare({Filled=true,Visible=false,Color=Color3.fromRGB(10,10,10)}),
        hpFill=mkSquare({Filled=true,Visible=false}),
        -- Labels
        name=mkText({Size=13,Center=true,Outline=true,OutlineColor=Color3.new(0,0,0),Visible=false}),
        dist=mkText({Size=11,Center=true,Outline=true,OutlineColor=Color3.new(0,0,0),Visible=false}),
        -- Snapline
        snap=mkLine({Thickness=1,Visible=false,Transparency=0.4}),
        -- Head dot
        dot=mkCircle({Filled=true,NumSides=16,Radius=3,Visible=false}),
        -- Skeleton (10 bone connections)
        sk={},
    }
    for i=1,10 do o.sk[i]=mkLine({Thickness=1,Visible=false}) end
    ESP[player]=o
    return o
end

local function hideObj(o)
    for _,v in pairs(o) do
        if type(v)=="table" then for _,l in pairs(v) do pcall(function()l.Visible=false end) end
        else pcall(function()v.Visible=false end) end
    end
end

local function clearESP(player)
    local o=ESP[player]; if not o then return end
    for _,v in pairs(o) do
        if type(v)=="table" then for _,l in pairs(v) do pcall(function()l:Remove()end) end
        else pcall(function()v:Remove()end) end
    end
    ESP[player]=nil
end

local function setLine(l,x1,y1,x2,y2,col,th,tr)
    l.From=Vector2.new(x1,y1); l.To=Vector2.new(x2,y2)
    l.Color=col; l.Thickness=th; l.Transparency=tr; l.Visible=true
end

local SKEL_CONN = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},
    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},
}

local function updateESP()
    if not CFG.ESPEnabled then
        for _,o in pairs(ESP) do hideObj(o) end; return
    end
    local lChar=LP.Character
    local lHRP=lChar and lChar:FindFirstChild("HumanoidRootPart")

    for _,player in ipairs(Players:GetPlayers()) do
        if player==LP then continue end
        local char=player.Character
        if not char then clearESP(player); continue end
        local hrp=char:FindFirstChild("HumanoidRootPart")
        local hum=char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health<=0 then clearESP(player); continue end

        local wd=lHRP and (hrp.Position-lHRP.Position).Magnitude or 0
        if wd>CFG.ESPDistLimit then
            local o=ESP[player]; if o then hideObj(o) end; continue
        end

        local o=getESPObj(player)
        local col=CFG.BoxColor
        local th=CFG.BoxThick
        local tr=1-CFG.ESPOpacity

        -- Projection points
        local hp3,hOn=Cam:WorldToViewportPoint(hrp.Position+Vector3.new(0,2.8,0))
        local fp3,fOn=Cam:WorldToViewportPoint(hrp.Position-Vector3.new(0,3.0,0))
        local rp3,rOn=Cam:WorldToViewportPoint(hrp.Position)

        if not rOn then hideObj(o); continue end

        local hp=Vector2.new(hp3.X,hp3.Y)
        local fp=Vector2.new(fp3.X,fp3.Y)
        local rp=Vector2.new(rp3.X,rp3.Y)

        local bH=math.abs(hp.Y-fp.Y)
        local bW=math.max(bH*0.5,20)
        local bX=rp.X-bW/2
        local bY=hp.Y
        local cs=math.max(5,bW*0.25)
        local csY=math.max(5,bH*0.2)

        if CFG.BoxESP then
            -- Full box (dim)
            local dimCol=Color3.new(col.R*0.4,col.G*0.4,col.B*0.4)
            setLine(o.bT,bX,bY,bX+bW,bY,dimCol,th,tr+0.5)
            setLine(o.bB,bX,bY+bH,bX+bW,bY+bH,dimCol,th,tr+0.5)
            setLine(o.bL,bX,bY,bX,bY+bH,dimCol,th,tr+0.5)
            setLine(o.bR,bX+bW,bY,bX+bW,bY+bH,dimCol,th,tr+0.5)
            -- Corners (bright)
            if CFG.CornerBox then
                local accC=T.AccL
                setLine(o.cTL1,bX,bY,bX+cs,bY,accC,th+0.5,tr)
                setLine(o.cTL2,bX,bY,bX,bY+csY,accC,th+0.5,tr)
                setLine(o.cTR1,bX+bW-cs,bY,bX+bW,bY,accC,th+0.5,tr)
                setLine(o.cTR2,bX+bW,bY,bX+bW,bY+csY,accC,th+0.5,tr)
                setLine(o.cBL1,bX,bY+bH-csY,bX,bY+bH,accC,th+0.5,tr)
                setLine(o.cBL2,bX,bY+bH,bX+cs,bY+bH,accC,th+0.5,tr)
                setLine(o.cBR1,bX+bW,bY+bH-csY,bX+bW,bY+bH,accC,th+0.5,tr)
                setLine(o.cBR2,bX+bW-cs,bY+bH,bX+bW,bY+bH,accC,th+0.5,tr)
            else
                for _,l in pairs({o.cTL1,o.cTL2,o.cTR1,o.cTR2,o.cBL1,o.cBL2,o.cBR1,o.cBR2}) do l.Visible=false end
            end
        else
            for _,l in pairs({o.bT,o.bB,o.bL,o.bR,o.cTL1,o.cTL2,o.cTR1,o.cTR2,o.cBL1,o.cBL2,o.cBR1,o.cBR2}) do l.Visible=false end
        end

        -- Health bar
        if CFG.HealthESP then
            local hpR=math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
            local barX=bX-6
            o.hpBG.Position=Vector2.new(barX-1,bY-1)
            o.hpBG.Size=Vector2.new(5,bH+2)
            o.hpBG.Transparency=tr; o.hpBG.Visible=true
            o.hpFill.Position=Vector2.new(barX,bY+bH-(bH*hpR))
            o.hpFill.Size=Vector2.new(4,bH*hpR)
            o.hpFill.Color=Color3.fromHSV(hpR*0.33,1,1)
            o.hpFill.Transparency=tr; o.hpFill.Visible=true
        else o.hpBG.Visible=false; o.hpFill.Visible=false end

        -- Name
        if CFG.NameESP then
            o.name.Position=Vector2.new(rp.X,bY-15)
            o.name.Text=player.Name
            o.name.Color=CFG.NameColor
            o.name.Transparency=tr; o.name.Visible=true
        else o.name.Visible=false end

        -- Distance
        if CFG.DistESP then
            o.dist.Position=Vector2.new(rp.X,bY+bH+3)
            o.dist.Text=math.floor(wd).."m"
            o.dist.Color=CFG.DistColor
            o.dist.Transparency=tr; o.dist.Visible=true
        else o.dist.Visible=false end

        -- Snapline
        if CFG.Snaplines then
            local vs=Cam.ViewportSize
            o.snap.From=Vector2.new(vs.X/2,vs.Y)
            o.snap.To=rp; o.snap.Color=col
            o.snap.Transparency=tr+0.3; o.snap.Visible=true
        else o.snap.Visible=false end

        -- Head dot
        if CFG.HeadDot then
            o.dot.Position=hp; o.dot.Color=T.AccL
            o.dot.Radius=math.max(2,bW*0.06)
            o.dot.Transparency=tr; o.dot.Visible=true
        else o.dot.Visible=false end

        -- Skeleton
        if CFG.SkeletonESP then
            for i,conn in ipairs(SKEL_CONN) do
                local b1=char:FindFirstChild(conn[1])
                local b2=char:FindFirstChild(conn[2])
                local sl=o.sk[i]
                if sl and b1 and b2 then
                    local s1,on1=Cam:WorldToViewportPoint(b1.Position)
                    local s2,on2=Cam:WorldToViewportPoint(b2.Position)
                    if on1 and on2 then
                        sl.From=Vector2.new(s1.X,s1.Y); sl.To=Vector2.new(s2.X,s2.Y)
                        sl.Color=T.AccL; sl.Thickness=1; sl.Transparency=tr+0.2; sl.Visible=true
                    else sl.Visible=false end
                elseif sl then sl.Visible=false end
            end
        else for _,sl in ipairs(o.sk) do sl.Visible=false end end
    end

    -- Cleanup
    for pl in pairs(ESP) do
        if not pl or not pl.Parent then clearESP(pl) end
    end
end

Players.PlayerRemoving:Connect(function(p) clearESP(p) end)
Players.PlayerAdded:Connect(function(p)
    p.CharacterRemoving:Connect(function() clearESP(p) end)
end)
for _,p in ipairs(Players:GetPlayers()) do
    if p~=LP then p.CharacterRemoving:Connect(function() clearESP(p) end) end
end

-- ============================================================
-- FOV CIRCLE
-- ============================================================
local fovCircle=Drawing.new("Circle")
fovCircle.Visible=false; fovCircle.Filled=false
fovCircle.Thickness=1; fovCircle.NumSides=64; fovCircle.Transparency=0.55

-- ============================================================
-- AIMBOT — FOV PIXEL-BASED (FUNCIONAL)
-- ============================================================
local aimToggled=false
local lockedTarget=nil

local function getBone(char)
    if CFG.HeadPriority then
        local h=char:FindFirstChild("Head"); if h then return h end
    end
    if CFG.ChestPriority then
        local u=char:FindFirstChild("UpperTorso"); if u then return u end
    end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getAimTarget()
    local best,bestDist=nil,math.huge
    local vs=Cam.ViewportSize
    local center=Vector2.new(vs.X/2,vs.Y/2)
    local lChar=LP.Character
    local lHRP=lChar and lChar:FindFirstChild("HumanoidRootPart")

    for _,player in ipairs(Players:GetPlayers()) do
        if player==LP then continue end
        if CFG.TeamCheck and player.Team==LP.Team then continue end
        local char=player.Character; if not char then continue end
        local hum=char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health<=0 then continue end
        local bone=getBone(char); if not bone then continue end

        -- World distance
        if lHRP and (bone.Position-lHRP.Position).Magnitude>CFG.AimDist then continue end

        -- Visibility
        if CFG.VisCheck then
            local origin=Cam.CFrame.Position
            local dir=bone.Position-origin
            local rp=RaycastParams.new()
            rp.FilterDescendantsInstances={lChar,char}
            rp.FilterType=Enum.RaycastFilterType.Exclude
            if workspace:Raycast(origin,dir,rp) then continue end
        end

        local sp,onScreen=Cam:WorldToViewportPoint(bone.Position)
        if not onScreen or sp.Z<0 then continue end

        local sv=Vector2.new(sp.X,sp.Y)
        local sd=(sv-center).Magnitude
        if sd<=CFG.AimFOV and sd<bestDist then
            bestDist=sd
            best={player=player,bone=bone,screenPos=sv}
        end
    end
    return best
end

local function runAimbot()
    local vs=Cam.ViewportSize
    local center=Vector2.new(vs.X/2,vs.Y/2)

    -- FOV circle
    local showFov=CFG.AimEnabled and CFG.ShowFOV
    fovCircle.Visible=showFov
    if showFov then
        fovCircle.Position=center
        fovCircle.Radius=CFG.AimFOV
        fovCircle.Color=T.Acc
    end

    if not CFG.AimEnabled then lockedTarget=nil; return end

    -- Determine if should aim
    local shouldAim=false
    if CFG.AimMode=="Always" then shouldAim=true
    elseif CFG.AimMode=="Toggle" then shouldAim=aimToggled
    elseif CFG.AimMode=="Hold" then shouldAim=UserInputService:IsKeyDown(CFG.AimKey) end

    if not shouldAim then
        if not CFG.TargetLock then lockedTarget=nil end
        fovCircle.Color=T.Acc; return
    end
    fovCircle.Color=T.AccL

    local target=(CFG.TargetLock and lockedTarget) or getAimTarget()
    if not target then lockedTarget=nil; return end
    lockedTarget=CFG.TargetLock and target or nil

    -- Validate
    if not target.bone or not target.bone.Parent then lockedTarget=nil; return end
    local sp,onScreen=Cam:WorldToViewportPoint(target.bone.Position)
    if not onScreen or sp.Z<0 then lockedTarget=nil; return end

    local aimPos=Vector2.new(sp.X,sp.Y)
    local delta=aimPos-center

    -- Convert pixel delta to world angle delta
    local fovY=math.rad(Cam.FieldOfView)
    local fovX=2*math.atan(math.tan(fovY/2)*(vs.X/vs.Y))
    local dAngleX=(delta.X/vs.X)*fovX
    local dAngleY=(delta.Y/vs.Y)*fovY

    local smooth=math.clamp(CFG.AimSmooth,0.01,1)
    local camCF=Cam.CFrame
    local newCF=camCF*CFrame.Angles(0,-dAngleX*smooth,0)
    newCF=newCF*CFrame.Angles(-dAngleY*smooth,0,0)
    Cam.CFrame=newCF
end

-- ============================================================
-- FLY
-- ============================================================
local flyConn

applyFly=function(enabled)
    if flyConn then flyConn:Disconnect(); flyConn=nil end
    local char=LP.Character; if not char then return end
    local hrp=char:FindFirstChild("HumanoidRootPart")
    local hum=char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    if enabled then
        hum.PlatformStand=true
        local bv=Instance.new("BodyVelocity",hrp)
        bv.MaxForce=Vector3.new(1e6,1e6,1e6); bv.Velocity=Vector3.zero
        local bg=Instance.new("BodyGyro",hrp)
        bg.MaxTorque=Vector3.new(1e6,1e6,1e6); bg.D=50
        flyConn=RunService.Heartbeat:Connect(function()
            if not CFG.FlyEnabled then
                pcall(function()bv:Destroy();bg:Destroy()end)
                hum.PlatformStand=false
                flyConn:Disconnect(); flyConn=nil; return
            end
            local dir=Vector3.zero; local cf=Cam.CFrame
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir=dir+cf.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir=dir-cf.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir=dir-cf.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir=dir+cf.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir=dir+Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir=dir-Vector3.new(0,1,0) end
            bv.Velocity=dir.Magnitude>0 and dir.Unit*CFG.SpeedVal or Vector3.zero
            bg.CFrame=cf
        end)
    end
end

LP.CharacterAdded:Connect(function()
    task.wait(1); if CFG.FlyEnabled then applyFly(true) end
end)

-- ============================================================
-- NOCLIP
-- ============================================================
RunService.Stepped:Connect(function()
    if not CFG.NoClip then return end
    local char=LP.Character; if not char then return end
    for _,p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide=false end
    end
end)

-- ============================================================
-- CROSSHAIR
-- ============================================================
local CL={}
for i=1,4 do CL[i]=Drawing.new("Line"); CL[i].Visible=false end

RunService.RenderStepped:Connect(function()
    local show=CFG.Crosshair
    local cx=Cam.ViewportSize.X/2; local cy=Cam.ViewportSize.Y/2
    local sz=CFG.CrossSize; local th=CFG.CrossThick
    CL[1].From=Vector2.new(cx-sz,cy); CL[1].To=Vector2.new(cx-4,cy)
    CL[2].From=Vector2.new(cx+4,cy);  CL[2].To=Vector2.new(cx+sz,cy)
    CL[3].From=Vector2.new(cx,cy-sz); CL[3].To=Vector2.new(cx,cy-4)
    CL[4].From=Vector2.new(cx,cy+4);  CL[4].To=Vector2.new(cx,cy+sz)
    for _,l in ipairs(CL) do l.Color=T.White; l.Thickness=th; l.Visible=show end
end)

