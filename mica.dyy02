-- VL Debug Total | Xeno
warn("=== INICIO ===")

-- Aguarda jogo carregar
if not game:IsLoaded() then
    game.Loaded:Wait()
end
warn("Jogo carregado.")

local plr = game.Players.LocalPlayer
warn("Player: " .. plr.Name)

-- Conta descendants
local total = 0
for _, v in ipairs(game:GetDescendants()) do
    total = total + 1
end
warn("Total descendants: " .. total)

-- Lista TODOS os remotes sem filtro
warn("=== TODOS OS REMOTES ===")
local remoteCount = 0
for _, v in ipairs(game:GetDescendants()) do
    if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
        remoteCount = remoteCount + 1
        print(remoteCount .. ". " .. v.ClassName .. " | " .. v:GetFullName())
    end
end
warn("Total remotes: " .. remoteCount)

-- Lista TODOS os values do player
warn("=== PLAYER VALUES ===")
local valCount = 0
for _, v in ipairs(plr:GetDescendants()) do
    valCount = valCount + 1
    print(v.Name .. " [" .. v.ClassName .. "] = " .. tostring(v:IsA("ValueBase") and v.Value or "n/a"))
end
warn("Total descendants do player: " .. valCount)

-- Testa hookfunction
warn("=== HOOKFUNCTION TEST ===")
local ok, err = pcall(function()
    local re = Instance.new("RemoteEvent")
    hookfunction(re.FireServer, newcclosure(function(...) end))
    re:Destroy()
end)
warn("hookfunction disponivel: " .. tostring(ok))
if not ok then warn("Erro: " .. tostring(err)) end

warn("=== FIM DEBUG ===")
