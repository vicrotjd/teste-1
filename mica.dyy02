-- ============================================================
local fpsLbl=Drawing.new("Text")
fpsLbl.Visible=false; fpsLbl.Size=14; fpsLbl.Color=T.Acc
fpsLbl.Position=Vector2.new(8,8); fpsLbl.Outline=true
fpsLbl.OutlineColor=Color3.new(0,0,0); fpsLbl.Text="FPS: --"

local fc,lt=0,tick()
RunService.RenderStepped:Connect(function()
    fc=fc+1; local now=tick()
    if now-lt>=1 then fpsLbl.Text="FPS: "..fc; fc=0; lt=now end
    fpsLbl.Visible=CFG.FPSCounter
end)

-- ============================================================
-- INPUT
-- ============================================================
UserInputService.InputBegan:Connect(function(inp, gpe)
    if gpe then return end
    if inp.KeyCode==CFG.MenuKey then Win.Visible=not Win.Visible end
    if CFG.AimEnabled and CFG.AimMode=="Toggle" and inp.KeyCode==CFG.AimKey then
        aimToggled=not aimToggled
    end
end)

-- ============================================================
-- MAIN LOOPS
-- ============================================================
RunService.RenderStepped:Connect(function()
    pcall(runAimbot)
    pcall(updateESP)
end)

