-- Universal Remote & Value Scanner
-- Xeno / KRNL / Synapse / Solara compatible

local Players = game:GetService("Players")
local plr = Players.LocalPlayer

local function sep(title)
    warn(string.rep("=", 10) .. " " .. title .. " " .. string.rep("=", 10))
end

-- 1. TODOS OS REMOTES
sep("REMOTES")
local remotes = {}
for _, v in ipairs(game:GetDescendants()) do
    if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
        table.insert(remotes, v)
        print("[" .. v.ClassName .. "] " .. v:GetFullName())
    end
end
warn("Total: " .. #remotes)

-- 2. PLAYER LEADERSTATS / VALUES
sep("PLAYER DATA")
for _, v in ipairs(plr:GetDescendants()) do
    local t = v.ClassName
    if t:find("Value") then
        print(v.Name .. " = " .. tostring(v.Value) .. "  (" .. v:GetFullName() .. ")")
    end
end

-- 3. FIRESERVER HOOK ao vivo
sep("FIRESERVER HOOK — faz a acao agora")
local hooked = false

pcall(function()
    local orig = Instance.new("RemoteEvent").FireServer
    hookfunction(orig, newcclosure(function(self, ...)
        local args = {...}
        local s = "[FIRE] " .. self:GetFullName()
        for i, a in ipairs(args) do
            s = s .. " | [" .. i .. "] " .. tostring(a)
        end
        warn(s)
        return orig(self, ...)
    end))
    hooked = true
end)

if not hooked then
    -- fallback: monitora mudança nos values do player
    warn("hookfunction indisponivel — monitorando values do player")
    local tracked = {}
    for _, v in ipairs(plr:GetDescendants()) do
        if v:IsA("IntValue") or v:IsA("NumberValue") then
            tracked[v] = v.Value
            v.Changed:Connect(function(new)
                warn("[VALUE CHANGE] " .. v:GetFullName() .. ": " .. tostring(tracked[v]) .. " -> " .. tostring(new))
                tracked[v] = new
            end)
        end
    end
end

-- 4. MONITOR DE NOVOS REMOTES (spawns dinamicos)
sep("MONITOR DINAMICO")
game.DescendantAdded:Connect(function(v)
    if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
        warn("[NOVO REMOTE] " .. v:GetFullName())
    end
end)

warn("Scanner ativo. Faz a acao no jogo agora.")
