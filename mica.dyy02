-- ============================================================
--  MICA.DYY — Advanced Gaming Panel v2.0
--  Executor Compatible | Global Script
--  Insert = toggle menu | C = aimbot (hold)
-- ============================================================

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")
local HttpService      = game:GetService("HttpService")

local LP   = Players.LocalPlayer
local Cam  = workspace.CurrentCamera

local function getContainer()
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    return (ok and cg) or LP:WaitForChild("PlayerGui")
end

-- ============================================================
-- CONFIG
-- ============================================================
local CFG = {
    -- Aim
    AimEnabled    = false,
    AimKey        = Enum.KeyCode.C,
    AimMode       = "Hold",
    HeadPriority  = true,
    ChestPriority = false,
    AimFOV        = 150,
    AimSmooth     = 0.18,
    AimDist       = 600,
    ShowFOV       = true,
    TargetLock    = false,
    VisCheck      = false,
    TeamCheck     = false,
    -- Visuals
    ESPEnabled    = true,
    BoxESP        = true,
    CornerBox     = true,
    SkeletonESP   = true,
    NameESP       = true,
    HealthESP     = true,
    DistESP       = true,
    WeaponESP     = false,
    Snaplines     = false,
    HeadDot       = true,
    BoxThick      = 1.5,
    ESPOpacity    = 1.0,
    ESPDistLimit  = 600,
    EnemyColor    = Color3.fromRGB(150, 59, 255),
    BoxColor      = Color3.fromRGB(150, 59, 255),
    HealthColor   = Color3.fromRGB(0, 220, 80),
    NameColor     = Color3.fromRGB(255, 255, 255),
    DistColor     = Color3.fromRGB(180, 180, 190),
    ChamsEnabled  = false,
    ChamsTransp   = 0.5,
    -- Player
    GodMode       = false,
    FlyEnabled    = false,
