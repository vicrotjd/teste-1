                BoxThick=CFG.BoxThick,ESPDistLimit=CFG.ESPDistLimit,
            }))
        end)
        Notif("Config",ok and "Salva com sucesso!" or "Erro ao salvar",ok and "success" or "error")
    end)
    loadBtn.MouseButton1Click:Connect(function()
        local ok,data=pcall(function() return HttpService:JSONDecode(readfile("mica_dyy.json")) end)
        if ok and type(data)=="table" then
            for k,v in pairs(data) do if CFG[k]~=nil then CFG[k]=v end end
            Notif("Config","Carregada!","success")
        else Notif("Config","Arquivo não encontrado","error") end
    end)
end

