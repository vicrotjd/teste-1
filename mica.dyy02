        Size=UDim2.new(0.48,0,0,30), BackgroundColor3=T.AccD,
        Text="Salvar Config", TextColor3=T.AccL,
        Font=Enum.Font.GothamBold, TextSize=11, LayoutOrder=2,
    },c3); Corner(saveBtn,5)

    local loadBtn=New("TextButton",{
        Size=UDim2.new(0.48,0,0,30),
        Position=UDim2.new(0.52,0,0,0),
        BackgroundColor3=T.BG2, Text="Carregar Config",
        TextColor3=T.Sub, Font=Enum.Font.GothamBold, TextSize=11, LayoutOrder=3,
    },c3); Corner(loadBtn,5); Stroke(loadBtn,T.Border,1)

    saveBtn.MouseButton1Click:Connect(function()
        local ok=pcall(function()
            writefile("mica_dyy.json",HttpService:JSONEncode({
                AimEnabled=CFG.AimEnabled,ESPEnabled=CFG.ESPEnabled,
                AimFOV=CFG.AimFOV,AimSmooth=CFG.AimSmooth,AimDist=CFG.AimDist,
