-- Toggle Switch
local function MakeToggle(parent, label, tooltip, default, callback)
    local state = default or false
    
    local row = New("Frame", {
        Parent = parent,
        Size   = UDim2.new(1, 0, 0, 36),
        BackgroundTransparency = 1,
    })
    
    New("TextLabel", {
        Parent = row,
        Size   = UDim2.new(1, -56, 1, 0),
        BackgroundTransparency = 1,
        Text   = label,
        TextColor3 = C.White,
        TextSize = 12,
        Font   = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    
    local track = New("Frame", {
        Parent = row,
        Size   = UDim2.new(0, 44, 0, 22),
        Position = UDim2.new(1, -44, 0.5, -11),
        BackgroundColor3 = state and C.Accent or C.Border,
    })
    Corner(track, 11)
    
    local knob = New("Frame", {
        Parent = track,
        Size   = UDim2.new(0, 16, 0, 16),
        Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = C.White,
    })
    Corner(knob, 8)
    
    local btn = New("TextButton", {
        Parent = row,
        Size   = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text   = "",
    })
    
    btn.MouseButton1Click:Connect(function()
        state = not state
        Tween(track, {BackgroundColor3 = state and C.Accent or Color3.fromRGB(35,35,40)}, 0.15)
        Tween(knob, {Position = state and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8)}, 0.15)
        if callback then callback(state) end
    end)
    
    -- Tooltip
    if tooltip then
        local tip
        btn.MouseEnter:Connect(function()
            tip = New("TextLabel", {
                Parent = row,
                Size   = UDim2.new(0, 180, 0, 28),
                Position = UDim2.new(0, 0, 1, 4),
                BackgroundColor3 = C.BG2,
                Text   = tooltip,
                TextColor3 = C.Sub,
                TextSize = 10,
                Font   = Enum.Font.Gotham,
                ZIndex = 20,
                TextWrapped = true,
            })
            Corner(tip, 4)
            Stroke(tip, C.Border)
        end)
        btn.MouseLeave:Connect(function()
            if tip then tip:Destroy(); tip = nil end
        end)
    end
    
    return row, function() return state end, function(v)
        state = v
        Tween(track, {BackgroundColor3 = state and C.Accent or Color3.fromRGB(35,35,40)}, 0.15)
        Tween(knob, {Position = state and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8)}, 0.15)
    end
end

-- Slider
local function MakeSlider(parent, label, min, max, default, callback, suffix)
    local value = default or min
    suffix = suffix or ""
    
    local card = New("Frame", {
        Parent = parent,
        Size   = UDim2.new(1, 0, 0, 56),
        BackgroundTransparency = 1,
    })
    
    New("TextLabel", {
        Parent = card,
        Size   = UDim2.new(1, -50, 0, 18),
        BackgroundTransparency = 1,
        Text   = label,
        TextColor3 = C.White,
        TextSize = 12,
        Font   = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    
    local valLabel = New("TextLabel", {
        Parent = card,
        Size   = UDim2.new(0, 50, 0, 18),
        Position = UDim2.new(1, -50, 0, 0),
        BackgroundTransparency = 1,
        Text   = tostring(value) .. suffix,
        TextColor3 = C.Accent,
        TextSize = 12,
        Font   = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Right,
    })
    
    local track = New("Frame", {
        Parent = card,
        Size   = UDim2.new(1, 0, 0, 4),
        Position = UDim2.new(0, 0, 0, 28),
        BackgroundColor3 = C.Border,
    })
    Corner(track, 2)
    
    local fill = New("Frame", {
        Parent = track,
        Size   = UDim2.new((value - min)/(max - min), 0, 1, 0),
        BackgroundColor3 = C.Accent,
    })
    Corner(fill, 2)
    
    local handle = New("Frame", {
        Parent = track,
        Size   = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new((value - min)/(max - min), -6, 0.5, -6),
        BackgroundColor3 = C.AccentLight,
    })
    Corner(handle, 6)
    
    local dragging = false
    local btn = New("TextButton", {
        Parent = track,
        Size   = UDim2.new(1, 0, 0, 20),
        Position = UDim2.new(0, 0, 0.5, -10),
        BackgroundTransparency = 1,
        Text   = "",
    })
    
    local function updateSlider(input)
        local rel  = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * rel)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        handle.Position = UDim2.new(rel, -6, 0.5, -6)
        valLabel.Text = tostring(value) .. suffix
        if callback then callback(value) end
    end
    
    btn.MouseButton1Down:Connect(function() dragging = true; updateSlider(UserInputService:GetMouseLocation() and {Position = UserInputService:GetMouseLocation()} or {}) end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(i)
        end
    end)
    
    return card
end

-- Dropdown
local function MakeDropdown(parent, label, options, default, callback)
    local selected = default or options[1]
    local open = false
    
    local card = New("Frame", {
        Parent = parent,
        Size   = UDim2.new(1, 0, 0, 36),
        BackgroundTransparency = 1,
        ClipsDescendants = false,
        ZIndex = 5,
    })
    
    New("TextLabel", {
        Parent = card,
        Size   = UDim2.new(0.4, 0, 1, 0),
        BackgroundTransparency = 1,
        Text   = label,
        TextColor3 = C.White,
        TextSize = 12,
        Font   = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    
    local btn = New("TextButton", {
        Parent = card,
        Size   = UDim2.new(0.58, 0, 0, 28),
        Position = UDim2.new(0.42, 0, 0.5, -14),
        BackgroundColor3 = C.BG2,
        Text   = selected,
        TextColor3 = C.AccentLight,
        TextSize = 11,
        Font   = Enum.Font.Gotham,
    })
    Corner(btn, 4)
    Stroke(btn, C.Border)
    
    New("TextLabel", {
        Parent = btn,
        Size   = UDim2.new(0, 14, 1, 0),
        Position = UDim2.new(1, -18, 0, 0),
        BackgroundTransparency = 1,
        Text   = "▾",
        TextColor3 = C.Sub,
        TextSize = 10,
    })
    
    local dropdown = New("Frame", {
        Parent = card,
        Size   = UDim2.new(0.58, 0, 0, #options * 28 + 4),
        Position = UDim2.new(0.42, 0, 0, 36),
        BackgroundColor3 = C.BG2,
        Visible = false,
        ZIndex = 10,
    })
    Corner(dropdown, 4)
    Stroke(dropdown, C.Border)
    Padding(dropdown, 2, 0, 2, 0)
    
    for _, opt in ipairs(options) do
        local item = New("TextButton", {
            Parent = dropdown,
            Size   = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = opt == selected and C.AccentDim or Color3.fromRGB(0,0,0),
            BackgroundTransparency = opt == selected and 0 or 1,
            Text   = opt,
            TextColor3 = opt == selected and C.AccentLight or C.White,
            TextSize = 11,
            Font   = Enum.Font.Gotham,
            ZIndex = 11,
        })
        Corner(item, 3)
        item.MouseButton1Click:Connect(function()
            selected = opt
            btn.Text = opt
            open = false
            dropdown.Visible = false
            if callback then callback(opt) end
        end)
        item.MouseEnter:Connect(function()
            if opt ~= selected then
                Tween(item, {BackgroundTransparency = 0, BackgroundColor3 = C.BG}, 0.1)
            end
        end)
        item.MouseLeave:Connect(function()
            if opt ~= selected then
                Tween(item, {BackgroundTransparency = 1}, 0.1)
            end
        end)
    end
    
    ListLayout(dropdown, 0)
    
    btn.MouseButton1Click:Connect(function()
        open = not open
        dropdown.Visible = open
    end)
    
    return card
end

-- Keybind Capturer
local function MakeKeybind(parent, label, default, callback)
    local key = default
    local capturing = false
    
    local row = New("Frame", {
        Parent = parent,
        Size   = UDim2.new(1, 0, 0, 36),
        BackgroundTransparency = 1,
    })
    
    New("TextLabel", {
        Parent = row,
        Size   = UDim2.new(0.55, 0, 1, 0),
        BackgroundTransparency = 1,
        Text   = label,
        TextColor3 = C.White,
        TextSize = 12,
        Font   = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    
    local keyBtn = New("TextButton", {
        Parent = row,
        Size   = UDim2.new(0.43, 0, 0, 26),
        Position = UDim2.new(0.57, 0, 0.5, -13),
        BackgroundColor3 = C.BG2,
        Text   = tostring(key):gsub("Enum.KeyCode.", ""),
        TextColor3 = C.AccentLight,
        TextSize = 11,
        Font   = Enum.Font.GothamBold,
    })
    Corner(keyBtn, 4)
    Stroke(keyBtn, C.Border)
    
    keyBtn.MouseButton1Click:Connect(function()
        capturing = true
        keyBtn.Text = "[ ... ]"
        keyBtn.TextColor3 = C.Accent
        Stroke(keyBtn, C.Accent)
    end)
    
    UserInputService.InputBegan:Connect(function(input, gpe)
        if capturing and input.UserInputType == Enum.UserInputType.Keyboard then
            capturing = false
            key = input.KeyCode
            keyBtn.Text = tostring(key):gsub("Enum.KeyCode.", "")
            keyBtn.TextColor3 = C.AccentLight
            Stroke(keyBtn, C.Border)
            if callback then callback(key) end
        end
    end)
    
    return row
end

-- Section Header
local function SectionHeader(parent, text)
    local f = New("Frame", {
        Parent = parent,
        Size   = UDim2.new(1, 0, 0, 28),
        BackgroundTransparency = 1,
    })
    
    New("TextLabel", {
        Parent = f,
        Size   = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        Text   = text:upper(),
        TextColor3 = C.Accent,
        TextSize = 10,
        Font   = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    
    New("Frame", {
        Parent = f,
        Size   = UDim2.new(1, -80, 0, 1),
        Position = UDim2.new(0, 76, 0.5, 0),
        BackgroundColor3 = C.Border,
    })
    
    return f
end

-- Card container
local function MakeCard(parent, title, height)
    local card = New("Frame", {
        Parent = parent,
        Size   = UDim2.new(1, 0, 0, height or 200),
        BackgroundColor3 = C.Card,
    })
    Corner(card, 8)
    Stroke(card, C.Border)
    
    if title then
        New("TextLabel", {
            Parent = card,
            Size   = UDim2.new(1, -16, 0, 32),
            Position = UDim2.new(0, 12, 0, 0),
            BackgroundTransparency = 1,
            Text   = title,
            TextColor3 = C.AccentLight,
            TextSize = 12,
            Font   = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        
        New("Frame", {
            Parent = card,
            Size   = UDim2.new(1, -16, 0, 1),
            Position = UDim2.new(0, 8, 0, 32),
            BackgroundColor3 = C.Border,
        })
    end
    
    local content = New("Frame", {
        Parent = card,
        Size   = UDim2.new(1, -24, 1, -(title and 44 or 12)),
        Position = UDim2.new(0, 12, 0, title and 40 or 6),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    })
    ListLayout(content, 6)
    
    return card, content
end

