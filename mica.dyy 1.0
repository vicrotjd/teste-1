    MakeToggle(c2, "Performance Monitor", nil, Config.Misc.PerfMonitor, function(v) Config.Misc.PerfMonitor = v end)
    
    local _, c3 = MakeCard(scroll, "CONTROLES", 160)
    
    local panicBtn = New("TextButton", {
        Parent = c3,
        Size   = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Color3.fromRGB(30, 10, 10),
        Text   = "⚠  PANIC BUTTON",
        TextColor3 = C.Error,
        TextSize = 13,
        Font   = Enum.Font.GothamBold,
    })
    Corner(panicBtn, 6)
    Stroke(panicBtn, C.Error, 1)
    
    panicBtn.MouseButton1Click:Connect(function()
        Config.Aim.Enabled      = false
        Config.Visual.Enabled   = false
        Config.Player.FlyMode   = false
        Config.Player.NoClip    = false
        Config.Player.GodMode   = false
        Workspace.Gravity       = 196.2
        local char = LP and LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = 16
                hum.JumpPower = 50
            end
        end
        Notify("PANIC", "Todas as funções desativadas", "error")
    end)
    
    local saveBtn = New("TextButton", {
        Parent = c3,
        Size   = UDim2.new(0.48, 0, 0, 32),
        BackgroundColor3 = C.AccentDim,
        Text   = "Salvar Config",
        TextColor3 = C.AccentLight,
        TextSize = 12,
        Font   = Enum.Font.GothamBold,
    })
    Corner(saveBtn, 6)
    
    local loadBtn = New("TextButton", {
        Parent = c3,
        Size   = UDim2.new(0.48, 0, 0, 32),
        Position = UDim2.new(0.52, 0, 0, 0),
        BackgroundColor3 = C.BG2,
        Text   = "Carregar Config",
        TextColor3 = C.Sub,
        TextSize = 12,
        Font   = Enum.Font.GothamBold,
    })
    Corner(loadBtn, 6)
    
    saveBtn.MouseButton1Click:Connect(function()
        local ok, err = pcall(function()
            writefile("mica_dyy_config.json", HttpService:JSONEncode(Config))
        end)
        Notify("Config", ok and "Salva com sucesso!" or "Erro ao salvar", ok and "success" or "error")
    end)
    
    loadBtn.MouseButton1Click:Connect(function()
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile("mica_dyy_config.json"))
        end)
        if ok and data then
            for k, v in pairs(data) do Config[k] = v end
            Notify("Config", "Carregada com sucesso!", "success")
        else
            Notify("Config", "Arquivo não encontrado", "error")
        end
    end)
end

