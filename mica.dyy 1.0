-- ============================================================
-- NAVIGATION LOGIC
-- ============================================================
local function SwitchTab(tabName)
    for name, frame in pairs(Tabs) do
        if name == tabName then
            frame.Visible = true
            if Config.Settings.Animations then
                frame.Position = UDim2.new(0.03, 0, 0, 0)
                frame.BackgroundTransparency = 1
                Tween(frame, {Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1}, 0.18)
            end
        else
            frame.Visible = false
        end
    end
    HeaderTitle.Text = tabName:upper()
    ActiveTab = tabName
    for _, data in ipairs(NavButtons) do
        local isActive = data.tab == tabName
        Tween(data.bg, {BackgroundColor3 = isActive and C.AccentDim or Color3.fromRGB(0,0,0),
               BackgroundTransparency = isActive and 0 or 1}, 0.15)
        data.icon.TextColor3 = isActive and C.Accent or C.Sub
        data.label.TextColor3 = isActive and C.AccentLight or C.Sub
        if isActive then
            Tween(data.accent, {BackgroundTransparency = 0}, 0.15)
        else
            Tween(data.accent, {BackgroundTransparency = 1}, 0.15)
        end
    end
end

for i, nav in ipairs(NavItems) do
    local btn = New("TextButton", {
        Parent = NavContainer,
        Size   = UDim2.new(1, 0, 0, 44),
        BackgroundTransparency = 1,
        Text   = "",
    })
    
    local bg = New("Frame", {
        Parent = btn,
        Size   = UDim2.new(1, -8, 1, -4),
        Position = UDim2.new(0, 4, 0, 2),
        BackgroundColor3 = C.AccentDim,
        BackgroundTransparency = 1,
    })
    Corner(bg, 6)
    
    -- Left accent line
    local accent = New("Frame", {
        Parent = btn,
        Size   = UDim2.new(0, 3, 0.6, 0),
        Position = UDim2.new(0, 0, 0.2, 0),
        BackgroundColor3 = C.Accent,
        BackgroundTransparency = 1,
    })
    Corner(accent, 2)
    
    local iconLbl = New("TextLabel", {
        Parent = btn,
        Size   = UDim2.new(1, 0, 0, 22),
        Position = UDim2.new(0, 0, 0, 4),
        BackgroundTransparency = 1,
        Text   = nav.icon,
        TextColor3 = C.Sub,
        TextSize = 16,
        Font   = Enum.Font.GothamBold,
    })
    
    local labelLbl = New("TextLabel", {
        Parent = btn,
        Size   = UDim2.new(1, 0, 0, 14),
        Position = UDim2.new(0, 0, 0, 24),
        BackgroundTransparency = 1,
        Text   = nav.label:upper(),
        TextColor3 = C.Sub,
        TextSize = 8,
        Font   = Enum.Font.GothamBold,
    })
    
    NavButtons[#NavButtons+1] = {tab = nav.tab, bg = bg, icon = iconLbl, label = labelLbl, accent = accent}
    
    btn.MouseButton1Click:Connect(function()
        SwitchTab(nav.tab)
    end)
    
    btn.MouseEnter:Connect(function()
        if ActiveTab ~= nav.tab then
            Tween(iconLbl, {TextColor3 = C.White}, 0.1)
        end
    end)
    btn.MouseLeave:Connect(function()
        if ActiveTab ~= nav.tab then
            Tween(iconLbl, {TextColor3 = C.Sub}, 0.1)
        end
    end)
end

