    local scroll = MakeScrollFrame(tab)
    
    SectionHeader(scroll, "ESP GERAL")
    
    local _, c1 = MakeCard(scroll, "ESP ENABLE", 260)
    
    local espItems = {
        {"ESP Enable",    "Visual.Enabled"},
        {"Box ESP",       "Visual.Box2D"},
        {"Skeleton ESP",  "Visual.Skeleton"},
        {"Name ESP",      "Visual.Name"},
        {"Health ESP",    "Visual.Health"},
        {"Distance ESP",  "Visual.Distance"},
        {"Weapon ESP",    "Visual.Weapon"},
        {"Snaplines",     "Visual.Snaplines"},
        {"Head Dot",      "Visual.HeadDot"},
        {"2D Box",        "Visual.Box2D"},
        {"3D Box",        "Visual.Box3D"},
    }
    
    for _, item in ipairs(espItems) do
        local keys = {}
        for k in item[2]:gmatch("[^.]+") do keys[#keys+1] = k end
        local cfg = Config[keys[1]]
        MakeToggle(c1, item[1], nil, cfg[keys[2]], function(v)
            cfg[keys[2]] = v
        end)
    end
    
    SectionHeader(scroll, "ESP CUSTOMIZAÇÃO")
    
    local _, c2 = MakeCard(scroll, "APARÊNCIA", 180)
    
    MakeSlider(c2, "Line Thickness", 1, 5, Config.Visual.Thickness, function(v)
