-- ============================================================
-- UTILITIES
-- ============================================================
local function Tween(obj, props, t, style, dir)
    style = style or Enum.EasingStyle.Quart
    dir   = dir   or Enum.EasingDirection.Out
    TweenService:Create(obj, TweenInfo.new(t or 0.2, style, dir), props):Play()
end

local function New(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    return inst
end

local function Padding(parent, t, r, b, l)
    return New("UIPadding", {
        Parent           = parent,
        PaddingTop       = UDim.new(0, t or 8),
        PaddingRight     = UDim.new(0, r or 8),
        PaddingBottom    = UDim.new(0, b or 8),
        PaddingLeft      = UDim.new(0, l or 8),
    })
end

local function Corner(parent, r)
    return New("UICorner", {Parent = parent, CornerRadius = UDim.new(0, r or 6)})
end

local function Stroke(parent, color, thick)
    return New("UIStroke", {
        Parent    = parent,
        Color     = color or C.Border,
        Thickness = thick or 1,
    })
end

local function ListLayout(parent, padding, dir, align)
    return New("UIListLayout", {
        Parent          = parent,
        Padding         = UDim.new(0, padding or 8),
        FillDirection   = dir   or Enum.FillDirection.Vertical,
        HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
        SortOrder       = Enum.SortOrder.LayoutOrder,
    })
end

local function GridLayout(parent, cellSize, cellPadding)
    return New("UIGridLayout", {
        Parent      = parent,
        CellSize    = cellSize    or UDim2.new(0.5, -6, 0, 0),
        CellPaddingSize = cellPadding or UDim2.new(0, 8, 0, 8),
        SortOrder   = Enum.SortOrder.LayoutOrder,
        FillDirectionMaxCells = 2,
    })
end

-- Auto-resize frame to fit list children
local function AutoSize(frame, axis)
    local layout = frame:FindFirstChildOfClass("UIListLayout") or frame:FindFirstChildOfClass("UIGridLayout")
    if not layout then return end
    local function update()
        if axis == "X" then
            frame.Size = UDim2.new(frame.Size.X.Scale, frame.Size.X.Offset, 0, layout.AbsoluteContentSize.Y)
        else
            frame.Size = UDim2.new(frame.Size.X.Scale, frame.Size.X.Offset, 0, layout.AbsoluteContentSize.Y)
        end
    end
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(update)
    update()
end

-- ============================================================
-- NOTIFICATION SYSTEM
-- ============================================================
local NotifHolder
local function Notify(title, msg, ntype)
    if not NotifHolder then return end
    ntype = ntype or "info"
    local color = ntype == "success" and C.Success or ntype == "error" and C.Error or C.Accent
    
    local notif = New("Frame", {
        Parent = NotifHolder,
        Size   = UDim2.new(1, 0, 0, 60),
        BackgroundColor3 = C.Card,
        BackgroundTransparency = 1,
    })
    Corner(notif, 6)
    Stroke(notif, color, 1)
    
    New("Frame", {
        Parent = notif,
        Size   = UDim2.new(0, 3, 1, -8),
        Position = UDim2.new(0, 0, 0, 4),
        BackgroundColor3 = color,
    }, {New("UICorner", {CornerRadius = UDim.new(0, 2)})})
    
    New("TextLabel", {
        Parent = notif,
        Size   = UDim2.new(1, -16, 0, 18),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text   = title,
        TextColor3 = C.White,
        TextSize = 13,
        Font   = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    
    New("TextLabel", {
        Parent = notif,
        Size   = UDim2.new(1, -16, 0, 14),
        Position = UDim2.new(0, 12, 0, 30),
        BackgroundTransparency = 1,
        Text   = msg,
        TextColor3 = C.Sub,
        TextSize = 11,
        Font   = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
    })
    
    Tween(notif, {BackgroundTransparency = 0}, 0.3)
    
    task.delay(3, function()
        Tween(notif, {BackgroundTransparency = 1}, 0.3)
        task.wait(0.35)
        notif:Destroy()
    end)
end

-- ============================================================
-- GUI COMPONENTS
