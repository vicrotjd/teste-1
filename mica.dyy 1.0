end)

-- ============================================================
-- FLY IMPLEMENTATION
-- ============================================================
local flyConnection
local function applyFly(enabled)
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
    local char = LP and LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    
    if enabled then
        local bv = Instance.new("BodyVelocity", hrp)
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.zero
        local bg = Instance.new("BodyGyro", hrp)
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.D = 100
        
        hum.PlatformStand = true
        
        flyConnection = RunService.Heartbeat:Connect(function()
            if not Config.Player.FlyMode then
                bv:Destroy(); bg:Destroy()
                hum.PlatformStand = false
                flyConnection:Disconnect(); flyConnection = nil
                return
            end
            local dir = Vector3.zero
            local speed = Config.Player.Speed
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
            bv.Velocity = dir.Magnitude > 0 and dir.Unit * speed or Vector3.zero
            bg.CFrame = Camera.CFrame
        end)
    end
end

-- ============================================================
-- NOCLIP IMPLEMENTATION
-- ============================================================
RunService.Stepped:Connect(function()
    if Config.Player.NoClip then
        local char = LP and LP.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end
end)

-- ============================================================
-- ESP SYSTEM
-- ============================================================
local ESPObjects = {}

local function ClearESP(player)
    if ESPObjects[player] then
        for _, obj in pairs(ESPObjects[player]) do
            if obj.Remove then obj:Remove() elseif obj.Destroy then pcall(obj.Destroy, obj) end
        end
        ESPObjects[player] = nil
    end
end

local function CreateESP(player)
    if player == LP then return end
    ClearESP(player)
    
    local objs = {}
    
    -- Box
    local box = Drawing.new("Square")
    box.Visible   = false
    box.Color     = C.Accent
    box.Filled    = false
    box.Thickness = Config.Visual.Thickness
    box.Transparency = Config.Visual.Opacity
    objs.box = box
    
    -- Name
    local name = Drawing.new("Text")
    name.Visible   = false
    name.Color     = C.White
    name.Size      = 14
    name.Center    = true
    name.Outline   = true
    name.OutlineColor = Color3.fromRGB(0, 0, 0)
    name.Text      = player.Name
    objs.name = name
    
    -- Health bar
    local healthBG = Drawing.new("Square")
    healthBG.Visible = false
    healthBG.Color   = Color3.fromRGB(20, 20, 20)
    healthBG.Filled  = true
    objs.healthBG = healthBG
    
    local healthFill = Drawing.new("Square")
    healthFill.Visible = false
    healthFill.Color   = Color3.fromRGB(0, 200, 80)
    healthFill.Filled  = true
    objs.healthFill = healthFill
    
    -- Distance label
    local dist = Drawing.new("Text")
    dist.Visible = false
    dist.Color   = C.Sub
    dist.Size    = 12
    dist.Center  = true
    dist.Outline = true
    dist.OutlineColor = Color3.fromRGB(0, 0, 0)
    objs.dist = dist
    
    -- Snapline
    local line = Drawing.new("Line")
    line.Visible    = false
    line.Color      = C.Accent
    line.Thickness  = 1
    line.Transparency = 0.7
    objs.line = line
    
    ESPObjects[player] = objs
end

-- ESP update loop
RunService.RenderStepped:Connect(function()
    if not Config.Visual.Enabled then
        for player, objs in pairs(ESPObjects) do
            for _, obj in pairs(objs) do obj.Visible = false end
        end
        return
    end
    
    local localChar = LP and LP.Character
    local localHRP  = localChar and localChar:FindFirstChild("HumanoidRootPart")
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end
        
        local char = player.Character
        if not char then ClearESP(player); continue end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then
            ClearESP(player)
            continue
        end
        
        local distance = localHRP and (hrp.Position - localHRP.Position).Magnitude or 0
        if distance > Config.Visual.DistLimit then
            if ESPObjects[player] then
                for _, obj in pairs(ESPObjects[player]) do obj.Visible = false end
            end
            continue
        end
        
        if not ESPObjects[player] then CreateESP(player) end
        local objs = ESPObjects[player]
        if not objs then continue end
        
        -- World to screen
        local rootPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        local headPos, headOn   = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
        local feetPos, feetOn   = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
        
        if not onScreen then
            for _, obj in pairs(objs) do obj.Visible = false end
            continue
        end
        
        -- Box dimensions
        local boxH    = math.abs(headPos.Y - feetPos.Y)
        local boxW    = boxH * 0.5
        local boxX    = rootPos.X - boxW / 2
        local boxTopY = headPos.Y
        
        -- Box ESP
        if Config.Visual.Box2D and objs.box then
            objs.box.Visible   = true
            objs.box.Position  = Vector2.new(boxX, boxTopY)
            objs.box.Size      = Vector2.new(boxW, boxH)
            objs.box.Color     = Config.Visual.EnemyColor and Color3.fromRGB(table.unpack(Config.Visual.EnemyColor)) or C.Accent
            objs.box.Thickness = Config.Visual.Thickness
        elseif objs.box then objs.box.Visible = false end
        
        -- Name ESP
        if Config.Visual.Name and objs.name then
            objs.name.Visible   = true
            objs.name.Position  = Vector2.new(rootPos.X, boxTopY - 16)
            objs.name.Text      = player.Name
        elseif objs.name then objs.name.Visible = false end
        
        -- Health bar
        local hp     = hum.Health
        local maxHp  = hum.MaxHealth
        local hpRatio = math.clamp(hp / maxHp, 0, 1)
        
        if Config.Visual.Health and objs.healthBG then
            local barX = boxX - 6
            objs.healthBG.Visible  = true
            objs.healthBG.Position = Vector2.new(barX, boxTopY)
            objs.healthBG.Size     = Vector2.new(4, boxH)
            
            objs.healthFill.Visible  = true
            objs.healthFill.Position = Vector2.new(barX, boxTopY + boxH * (1 - hpRatio))
            objs.healthFill.Size     = Vector2.new(4, boxH * hpRatio)
            objs.healthFill.Color    = Color3.fromHSV(hpRatio * 0.33, 1, 1)
        else
            if objs.healthBG   then objs.healthBG.Visible  = false end
            if objs.healthFill then objs.healthFill.Visible = false end
        end
        
        -- Distance
        if Config.Visual.Distance and objs.dist then
            objs.dist.Visible   = true
            objs.dist.Position  = Vector2.new(rootPos.X, boxTopY + boxH + 2)
            objs.dist.Text      = math.floor(distance) .. "m"
        elseif objs.dist then objs.dist.Visible = false end
        
        -- Snaplines
        if Config.Visual.Snaplines and objs.line then
            objs.line.Visible = true
            objs.line.From    = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            objs.line.To      = Vector2.new(rootPos.X, rootPos.Y)
        elseif objs.line then objs.line.Visible = false end
    end
    
    -- Clean up players that left
    for player, _ in pairs(ESPObjects) do
        if not Players:FindFirstChild(player.Name) then
            ClearESP(player)
        end
    end
end)

-- Player event hooks for ESP
Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        ClearESP(player)
    end)
end)
Players.PlayerRemoving:Connect(function(player)
    ClearESP(player)
end)
for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LP then
        player.CharacterAdded:Connect(function()
            ClearESP(player)
        end)
    end
end

-- ============================================================
-- AIMBOT SYSTEM
-- ============================================================
local aimbotActive = false
local lockedTarget = nil

local function GetClosestTarget()
    local bestTarget, bestDist = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end
        if Config.Aim.TeamCheck then
            if player.Team == LP.Team then continue end
        end
        
        local char = player.Character
        if not char then continue end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        
        local bone = char:FindFirstChild(Config.Aim.HeadPriority and "Head" or "UpperTorso") or
                     char:FindFirstChild("HumanoidRootPart")
        if not bone then continue end
        
        local localHRP = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if localHRP and (bone.Position - localHRP.Position).Magnitude > Config.Aim.Distance then continue end
        
        if Config.Aim.VisCheck then
            local params = RaycastParams.new()
            params.FilterDescendantsInstances = {LP.Character, char}
            params.FilterType = Enum.RaycastFilterType.Exclude
            local result = Workspace:Raycast(Camera.CFrame.Position,
                (bone.Position - Camera.CFrame.Position).Unit * Config.Aim.Distance, params)
            if result then continue end
        end
        
        local screenPos, onScreen = Camera:WorldToViewportPoint(bone.Position)
        if not onScreen then continue end
        
        local screenV2 = Vector2.new(screenPos.X, screenPos.Y)
        local distFromCenter = (screenV2 - center).Magnitude
        
        if distFromCenter < Config.Aim.FOV / 2 and distFromCenter < bestDist then
            bestDist   = distFromCenter
            bestTarget = bone
        end
    end
    
    return bestTarget
end

-- FOV Circle
local fovCircle = Drawing.new("Circle")
fovCircle.Visible = false
fovCircle.Color   = C.Accent
fovCircle.Filled  = false
fovCircle.Thickness = 1
fovCircle.Transparency = 0.7
fovCircle.NumSides = 60

RunService.RenderStepped:Connect(function()
    -- FOV circle update
    local showFov = Config.Aim.Enabled and Config.Aim.ShowFOV
    fovCircle.Visible = showFov
    if showFov then
        fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        fovCircle.Radius   = Config.Aim.FOV / 2
    end
    
    -- Aimbot logic
    local shouldAim = false
    if Config.Aim.Mode == "Always" then
        shouldAim = Config.Aim.Enabled
    elseif Config.Aim.Mode == "Hold" then
        shouldAim = Config.Aim.Enabled and UserInputService:IsKeyDown(Config.Aim.Keybind)
    elseif Config.Aim.Mode == "Toggle" then
        shouldAim = Config.Aim.Enabled and aimbotActive
    end
    
    if shouldAim then
        local target = Config.Aim.Lock and lockedTarget or GetClosestTarget()
        if not target then lockedTarget = nil; return end
        if Config.Aim.Lock then lockedTarget = target end
        
        local targetPos, onScreen = Camera:WorldToViewportPoint(target.Position)
        if not onScreen then return end
        
        local smooth = math.clamp(1 - Config.Aim.Smoothness, 0.02, 1)
        local curPos  = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local aimPos  = Vector2.new(targetPos.X, targetPos.Y)
        
        -- Move camera
        local newCF = Camera.CFrame:ToWorldSpace(CFrame.new(
            (aimPos.X - curPos.X) * smooth * 0.01,
            -(aimPos.Y - curPos.Y) * smooth * 0.01,
            0
        ))
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position,
            Camera.CFrame.Position + Camera.CFrame.LookVector +
            (newCF.Position - Camera.CFrame.Position)
        )
    else
        lockedTarget = nil
    end
end)

-- Toggle keybind for aimbot toggle mode
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if Config.Aim.Mode == "Toggle" and input.KeyCode == Config.Aim.Keybind then
        aimbotActive = not aimbotActive
    end
end)

-- ============================================================
-- CROSSHAIR
-- ============================================================
local crossLines = {}
for i = 1, 4 do
    local l = Drawing.new("Line")
    l.Color     = Color3.fromRGB(255, 255, 255)
    l.Thickness = 2
    l.Visible   = false
    crossLines[i] = l
end

RunService.RenderStepped:Connect(function()
    local show = Config.Misc.Crosshair
    local cx = Camera.ViewportSize.X / 2
    local cy = Camera.ViewportSize.Y / 2
    local sz = Config.Misc.CrosshairSize
    
    if show then
        crossLines[1].From = Vector2.new(cx - sz, cy); crossLines[1].To = Vector2.new(cx - 3, cy)
        crossLines[2].From = Vector2.new(cx + 3, cy);  crossLines[2].To = Vector2.new(cx + sz, cy)
        crossLines[3].From = Vector2.new(cx, cy - sz); crossLines[3].To = Vector2.new(cx, cy - 3)
        crossLines[4].From = Vector2.new(cx, cy + 3);  crossLines[4].To = Vector2.new(cx, cy + sz)
    end
    for _, l in ipairs(crossLines) do l.Visible = show end
end)

-- ============================================================
-- FPS COUNTER (Drawing)
-- ============================================================
local fpsLabel = Drawing.new("Text")
fpsLabel.Visible  = false
fpsLabel.Color    = C.Accent
fpsLabel.Size     = 14
fpsLabel.Position = Vector2.new(8, 8)
fpsLabel.Outline  = true
fpsLabel.OutlineColor = Color3.fromRGB(0, 0, 0)

local frameCount = 0
local lastTime   = tick()

RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local now  = tick()
    if now - lastTime >= 1 then
        fpsLabel.Text = "FPS: " .. frameCount
        frameCount    = 0
        lastTime      = now
    end
    fpsLabel.Visible = Config.Misc.FPSCounter
end)

