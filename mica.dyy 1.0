    MakeToggle(c3, "Visible Chams",     nil, Config.Visual.ChamsVisible, function(v) Config.Visual.ChamsVisible = v end)
    MakeToggle(c3, "Occluded Chams",    nil, Config.Visual.ChamsOccluded,function(v) Config.Visual.ChamsOccluded = v end)
    MakeToggle(c3, "Chams Outline",     nil, Config.Visual.ChamsOutline, function(v) Config.Visual.ChamsOutline = v end)
    
