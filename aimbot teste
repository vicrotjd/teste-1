        gui.Enabled = not gui.Enabled
    end)

    -- Scroll Frame para opções
    local scrollFrame = Instance.new("ScrollingFrame", main)
    scrollFrame.Name = "Options"
    scrollFrame.Size = UDim2.new(1, -10, 1, -40)
    scrollFrame.Position = UDim2.new(0, 5, 0, 35)
    scrollFrame.BackgroundTransparency = 1
    scrollFrame.BorderSizePixel = 0
    scrollFrame.ScrollBarThickness = 4
    scrollFrame.ScrollBarImageColor3 = Color3.fromRGB(100, 100, 100)
    
    local listLayout = Instance.new("UIListLayout", scrollFrame)
    listLayout.Padding = UDim.new(0, 8)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local function createToggle(title, default, callback)
        local toggleFrame = Instance.new("Frame", scrollFrame)
        toggleFrame.Name = "Toggle_" .. title
        toggleFrame.Size = UDim2.fromScale(1, 0)
        toggleFrame.AutoHeight = true
        toggleFrame.BackgroundTransparency = 1
        
        local label = Instance.new("TextLabel", toggleFrame)
        label.Size = UDim2.fromScale(0.6, 1)
        label.BackgroundTransparency = 1
        label.Text = title
        label.TextColor3 = Color3.fromRGB(200, 200, 200)
        label.Font = Enum.Font.Gotham
        label.TextSize = 14
        label.TextXAlignment = Enum.TextXAlignment.Left
        
        local btn = Instance.new("TextButton", toggleFrame)
        btn.Size = UDim2.fromOffset(60, 28)
        btn.Position = UDim2.new(1, -60, 0, 0)
        btn.BackgroundColor3 = default and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(60, 60, 70)
        btn.Text = default and "ON" or "OFF"
        btn.TextColor3 = Color3.new(1,1,1)
        btn.Font = Enum.Font.GothamBold
        btn.BorderSizePixel = 0
        local btnCorner = Instance.new("UICorner", btn)
        btnCorner.CornerRadius = UDim.new(0, 6)
        
        btn.MouseButton1Click:Connect(function()
            local newVal = not (btn.Text == "ON")
            btn.Text = newVal and "ON" or "OFF"
            btn.BackgroundColor3 = newVal and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(60, 60, 70)
            if callback then callback(newVal) end
        end)
        
        return btn
    end

    local function createSlider(title, minValue, maxValue, defaultValue, callback)
        local sliderFrame = Instance.new("Frame", scrollFrame)
        sliderFrame.Name = "Slider_" .. title
        sliderFrame.Size = UDim2.fromScale(1, 0)
        sliderFrame.AutoHeight = true
        sliderFrame.BackgroundTransparency = 1
        
        local label = Instance.new("TextLabel", sliderFrame)
        label.Size = UDim2.fromScale(1, 0.5)
        label.BackgroundTransparency = 1
        label.Text = title .. " (" .. defaultValue .. ")"
        label.TextColor3 = Color3.fromRGB(200, 200, 200)
        label.Font = Enum.Font.Gotham
        label.TextSize = 14
        label.TextXAlignment = Enum.TextXAlignment.Left
        
        local bar = Instance.new("Frame", sliderFrame)
        bar.Size = UDim2.fromScale(1, 0.5)
        bar.Position = UDim2.fromScale(0, 0.5)
        bar.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        bar.BorderSizePixel = 0
        local barCorner = Instance.new("UICorner", bar)
        barCorner.CornerRadius = UDim.new(0, 4)
        
        local fill = Instance.new("Frame", bar)
        fill.Name = "Fill"
        fill.Size = UDim2.fromScale((defaultValue - minValue) / (maxValue - minValue), 1)
        fill.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        fill.BorderSizePixel = 0
        local fillCorner = Instance.new("UICorner", fill)
        fillCorner.CornerRadius = UDim.new(0, 4)
        
        local handle = Instance.new("TextButton", bar)
        handle.Size = UDim2.fromOffset(20, 20)
        handle.Position = UDim2.fromScale((defaultValue - minValue) / (maxValue - minValue), 0)
        handle.AnchorPoint = Vector2.new(0.5, 0)
        handle.BackgroundColor3 = Color3.new(1,1,1)
        handle.BorderSizePixel = 0
        handle.Text = ""
        local handleCorner = Instance.new("UICorner", handle)
        handleCorner.CornerRadius = UDim.new(1, 0)
        
        local dragging = false
        local dragInput
        local dragBegin
        local beginPos
        
        handle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                dragBegin = handle.Position
                beginPos = input.Position
            end
        end)
        
        handle.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        
        handle.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                dragInput = input
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input == dragInput then
                local delta = Vector2.new(input.Position.X - beginPos.X, input.Position.Y - beginPos.Y)
                local newScale = math.clamp(dragBegin.X.Scale + (delta.X / main.AbsoluteSize.X), 0, 1)
                handle.Position = UDim2.fromScale(newScale, 0)
                fill.Size = UDim2.fromScale(newScale, 1)
                
                local val = minValue + (newScale * (maxValue - minValue))
                label.Text = title .. " (" .. string.format("%.2f", val) .. ")"
                if callback then callback(val) end
            end
        end)
        
        return handle
    end

    -- Adicionar Opções
    createToggle("ESP", CFG.ENABLE_ESP, function(v) CFG.ENABLE_ESP = v end)
    createToggle("Aimbot", CFG.ENABLE_AIMBOT, function(v) CFG.ENABLE_AIMBOT = v end)
    createToggle("FOV Circle", CFG.ENABLE_FOV, function(v) CFG.ENABLE_FOV = v end)
    createToggle("Show Names", CFG.SHOW_NAMES, function(v) CFG.SHOW_NAMES = v end
