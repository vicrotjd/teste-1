-- Universal Roblox ESP & Aimbot (GitHub Optimized)
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- CONFIG
local CFG = {
    AIM_KEY = Enum.KeyCode.C,
    SMOOTHING = 0.12,
    MAX_DIST = 400,
    ESP_COLOR = Color3.new(0, 1, 0.5),
    FOV_RADIUS = 100, -- Visual apenas
    SHOW_NAMES = true
}

local state = {
    aiming = false,
    target = nil
}

-- Utility: Get HumanoidRootPart
local function getHRP(model)
    if not model then return nil end
    local hrp = model:FindFirstChild("HumanoidRootPart")
    return (hrp and hrp:IsA("BasePart")) and hrp or nil
end

-- Utility: World to Screen
local function W2S(pos)
    return Camera:WorldToViewportPoint(pos)
end

-- Utility: Is Friendly (Same Team)
local function isFriendly(model)
    if model == LocalPlayer.Character then return true end
    local team = model:FindFirstChildOfClass("Team")
    if team and team.Team == LocalPlayer.Team then return true end
    return false
end

-- Logic: Find Best Target
local function getTarget()
    local best = nil
    local bestDot = -math.huge
    local camPos = Camera.CFrame.Position
    local lookVec = Camera.CFrame.LookVector

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char then continue end
        if isFriendly(char) then continue end

        local hrp = getHRP(char)
        if not hrp then continue end

        local dist = (camPos - hrp.Position).Magnitude
        if dist > CFG.MAX_DIST then continue end

        local dir = (hrp.Position - camPos).Unit
        local dot = lookVec:Dot(dir)

        -- Prioriza quem está mais centralizado e mais próximo
        if dot > 0.95 and (not best or dot > bestDot or dist < best.dist) then
            best = {
                model = plr,
                hrp = hrp,
                pos = hrp.Position,
                dot = dot,
                dist = dist
            }
            bestDot = dot
        end
    end
    return best
end

-- Render: ESP + FOV
local function renderESP()
    local objects = {}
    local camPos = Camera.CFrame.Position

    -- 1. Draw FOV Circle (Center Screen)
    table.insert(objects, {
        Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2),
        Size = Vector2.new(CFG.FOV_RADIUS, CFG.FOV_RADIUS),
        Thickness = 2,
        Color = Color3.new(1, 1, 1),
        Filled = false,
        Visible = true
    })

    -- 2. Draw Players
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char then continue end
        if isFriendly(char) then continue end

        local hrp = getHRP(char)
        if not hrp then continue end

        local screenPos, onScreen = W2S(hrp.Position)
        if not onScreen then continue end

        local dist = (camPos - hrp.Position).Magnitude
        local size = math.clamp(40 / dist, 10, 60)
        local color = CFG.ESP_COLOR
        if state.target and state.target.model == plr then
            color = Color3.new(1, 0, 0) -- Vermelho se for o alvo do Aimbot
        end

        -- Box
        table.insert(objects, {
            Position = Vector2.new(screenPos.X, screenPos.Y),
            Size = Vector2.new(size, size),
            Thickness = 2,
            Color = color,
            Filled = false,
            Visible = true
        })

        -- Name
        if CFG.SHOW_NAMES then
            table.insert(objects, {
                Text = plr.Name,
                Color = Color3.new(1, 1, 1),
                BackgroundColor3 = Color3.new(0, 0, 0),
                BackgroundTransparency = 0.6,
                Position = Vector2.new(screenPos.X, screenPos.Y - size),
                Size = Vector2.new(0, 0),
                Visible = true
            })
        end
    end

    Camera:DrawToScreen(objects)
end

-- Logic: Aimbot
local function applyAimbot()
    if not state.aiming then return end

    local target = getTarget()
    state.target = target

    if target then
        local camCF = Camera.CFrame
        local targetPos = target.pos
        local desiredLook = (targetPos - camCF.Position).Unit
        
        -- Lerp suave
        local currentLook = camCF.LookVector
        local newLook = currentLook:Lerp(desiredLook, CFG.SMOOTHING)
        
        -- Aplica apenas a rotação, mantendo a posição
        Camera.CFrame = CFrame.lookAt(camCF.Position, camCF.Position + newLook)
    end
end

-- Input Handling
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == CFG.AIM_KEY then
        state.aiming = true
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if input.KeyCode == CFG.AIM_KEY then
        state.aiming = false
    end
end)

-- Main Loop
RunService.RenderStepped:Connect(function()
    applyAimbot()
    renderESP()
end)

print("[Universal ESP] Ativo. Segure " .. CFG.AIM_KEY.Name .. " para mirar.")
