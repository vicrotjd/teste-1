-- ==========================================
-- UTILITÁRIOS
-- ==========================================
local function getRoot(model)
    if not model or not model:IsA("Model") then return nil end
    return model:FindFirstChild("HumanoidRootPart")
end

local function getBodyPart(model, name)
    if not model then return nil end
    return model:FindFirstChild(name)
end

local function isFriendly(model)
    if model == LocalPlayer.Character then return true end
    local team = model:FindFirstChildOfClass("Team")
    if team and team.Team == LocalPlayer.Team then return true end
    return false
end

-- ==========================================
-- ESP: STICKMAN (BONECO PALITO)
-- ==========================================
local function createStickmanESP(player)
    if state.billboards[player.Name] then
        return state.billboards[player.Name]
    end

    local char = player.Character
    if not char then return nil end

    local hrp = getRoot(char)
    if not hrp then return nil end

    local bgui = Instance.new("BillboardGui")
    bgui.Name = "StickmanESP_" .. player.Name
    bgui.Adornee = hrp
    bgui.Size = UDim2.fromOffset(200, 200)
    bgui.StudsOffset = Vector3.new(0, 1, 0)
    bgui.AlwaysOnTop = true
    bgui.Active = false
    bgui.ResetOnSpawn = false
    bgui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    -- Frame Principal (Invisível)
    local mainFrame = Instance.new("Frame", bgui)
    mainFrame.Name = "MainFrame"
    mainFrame.Size = UDim2.fromScale(1, 1)
    mainFrame.BackgroundTransparency = 1
    mainFrame.BorderSizePixel = 0

    -- "Linhas" do Boneco Palito (Frames finos)
    -- Estrutura: Head, Torso, LeftArm, RightArm, LeftLeg, RightLeg
    
    local function createLine(name, size, pos, anchor)
        local line = Instance.new("Frame", mainFrame)
        line.Name = name
        line.Size = size
        line.Position = pos
        line.AnchorPoint = anchor
        line.BackgroundColor3 = CFG.ESP_COLOR
        line.BorderSizePixel = 0
        return line
    end

    -- Cabeça (Quadrado)
    local head = Instance.new("Frame", mainFrame)
    head.Name = "Head"
    head.Size = UDim2.fromOffset(20, 20)
    head.Position = UDim2.fromScale(0.5, 0.3)
    head.AnchorPoint = Vector2.new(0.5, 0.5)
    head.BackgroundColor3 = Color3.new(0,0,0)
    head.BorderSizePixel = 0
    local headStroke = Instance.new("UIStroke", head)
    headStroke.Color = CFG.ESP_COLOR
    headStroke.Thickness = 2

    -- Torso (Linha Vertical)
    local torso = createLine("Torso", UDim2.fromOffset(4, 60), UDim2.fromScale(0.5, 0.6), Vector2.new(0.5, 0.5))
    
    -- Braço Esquerdo (Linha Diagonal)
    local leftArm = createLine("LeftArm", UDim2.fromOffset(4, 40), UDim2.fromScale(0.4, 0.45), Vector2.new(1, 0.5))
    leftArm.Rotation = 30
    
    -- Braço Direito (Linha Diagonal)
    local rightArm = createLine("RightArm", UDim2.fromOffset(4, 40), UDim2.fromScale(0.6, 0.45), Vector2.new(0, 0.5))
    rightArm.Rotation = -30

    -- Perna Esquerda (Linha Diagonal)
    local leftLeg = createLine("LeftLeg", UDim2.fromOffset(4, 50), UDim2.fromScale(0.45, 0.8), Vector2.new(1, 0))
    leftLeg.Rotation = 20

    -- Perna Direita (Linha Diagonal)
    local rightLeg = createLine("RightLeg", UDim2.fromOffset(4, 50), UDim2.fromScale(0.55, 0.8), Vector2.new(0, 0))
    rightLeg.Rotation = -20

    -- Nome
    local nameLabel = Instance.new("TextLabel", mainFrame)
    nameLabel.Name = "NameLabel"
    nameLabel.Size = UDim2.fromScale(1, 0.1)
    nameLabel.Position = UDim2.fromScale(0, -0.1)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.new(1, 1, 1)
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 14
    nameLabel.Visible = CFG.SHOW_NAMES

    state.billboards[player.Name] = bgui
    return bgui
end

local function destroyStickmanESP(playerName)
    local bgui = state.billboards[playerName]
    if bgui then
        bgui:Destroy()
        state.billboards[playerName] = nil
    end
end

local function updateESP()
    local camPos = Camera.CFrame.Position
    local activeCount = 0
    local visiblePlayers = {}

    -- Identifica players visíveis
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character then continue end
        if isFriendly(player.Character) then
            destroyStickmanESP(player.Name)
            continue
        end

        local hrp = getRoot(player.Character)
        if not hrp then continue end

        local dist = (camPos - hrp.Position).Magnitude
        if dist <= CFG.MAX_DIST then
            table.insert(visiblePlayers, player)
            activeCount += 1
        else
            destroyStickmanESP(player.Name)
        end
    end

    -- Limita a quantidade de ESPs
    if activeCount > CFG.MAX_ESP_OBJECTS then
        -- Remove os mais distantes se passar do limite
        table.sort(visiblePlayers, function(a, b)
            local aHRP = getRoot(a.Character)
            local bHRP = getRoot(b.Character)
            if not aHRP or not bHRP then return true end
            return (camPos - aHRP.Position).Magnitude > (camPos - bHRP.Position).Magnitude
        end)
        
        for i = CFG.MAX_ESP_OBJECTS + 1, #visiblePlayers do
            destroyStickmanESP(visiblePlayers[i].Name)
        end
    end

    -- Cria/Atualiza ESPs
    for _, player in ipairs(visiblePlayers) do
        if not state.billboards[player.Name] then
            createStickmanESP(player)
        else
            local bgui = state.billboards[player.Name]
            bgui.Enabled = CFG.ENABLE_ESP
            
            -- Atualiza cor se for alvo
            local mainFrame = bgui:FindFirstChild("MainFrame")
            if mainFrame then
                local head = mainFrame:FindFirstChild("Head")
                if head then
                    local stroke = head:FindFirstChildOfClass("UIStroke")
                    if stroke then
                        if state.target and state.target.model == player then
                            stroke.Color = CFG.TARGET_COLOR
                        else
                            stroke.Color = CFG.ESP_COLOR
                        end
                    end
                end
            end
        end
    end
end

-- ==========================================
-- AIMBOT
-- ==========================================
local function getTarget()
    local best = nil
    local bestScore = -math.huge
    local camPos = Camera.CFrame.Position
    local lookVec = Camera.CFrame.LookVector

    if not (camPos and lookVec) then return nil end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character then continue end
        if isFriendly(player.Character) then continue end

        local hrp = getRoot(player.Character)
        if not hrp then continue end

        local dist = (camPos - hrp.Position).Magnitude
        if dist > CFG.MAX_DIST or dist == 0 then continue end

        local dir = (hrp.Position - camPos).Unit
        local dot = lookVec:Dot(dir)

        if dot > 0.9 then
            local score = dot - (dist / 1000)
            if score > bestScore then
                bestScore = score
                best = { model = player, hrp = hrp, pos = hrp.Position, dist = dist }
            end
        end
    end
    return best
end

local function applyAimbot()
    if not (CFG.ENABLE_AIMBOT and state.aiming) then
        state.target = nil
        return
    end

    local target = getTarget()
    state.target = target

    if target then
        local camCF = Camera.CFrame
        if not camCF:IsA("CFrame") or camCF.Position:Dot(Vector3.one) == 0 then return end
        
        local targetPos = target.pos
        local targetDir = (targetPos - camCF.Position)
        if targetDir.Magnitude < 0.1 then return end
        
        local desiredLook = targetDir.Unit
        local currentLook = camCF.LookVector
        local newLook = currentLook:Lerp(desiredLook, CFG.SMOOTHING)
        
        if newLook:Dot(Vector3.one) == 0 then return end

        Camera.CFrame = CFrame.lookAt(camCF.Position, camCF.Position + newLook)
    end
end

