-- Stickman ESP (Universal & Stable)
-- Desenha um boneco palito sobre todos os players inimigos.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- CONFIG
local CFG = {
    COLOR = Color3.fromRGB(0, 255, 128), -- Verde Neon
    MAX_DIST = 300, -- Distância máxima para mostrar o ESP
    LINE_THICKNESS = 3, -- Espessura das linhas
    SHOW_NAME = true, -- Mostra o nome do player
    IGNORE_FRIENDS = true -- Ignora players do mesmo time
}

local activeBillboards = {} -- Cache: [PlayerName] = BillboardGui

-- ==========================================
-- FUNÇÕES UTILITÁRIAS
-- ==========================================
local function getHRP(model)
    if not model or not model:IsA("Model") then return nil end
    return model:FindFirstChild("HumanoidRootPart")
end

local function isFriendly(model)
    if model == LocalPlayer.Character then return true end
    if not CFG.IGNORE_FRIENDS then return false end
    local team = model:FindFirstChildOfClass("Team")
    if team and team.Team == LocalPlayer.Team then return true end
    return false
end

-- ==========================================
-- CRIAÇÃO DO BONECO PALITO
-- ==========================================
local function createStickman(player)
    if activeBillboards[player.Name] then
        return activeBillboards[player.Name]
    end

    local char = player.Character
    if not char then return nil end
    local hrp = getHRP(char)
    if not hrp then return nil end

    local bgui = Instance.new("BillboardGui")
    bgui.Name = "StickmanESP_" .. player.Name
    bgui.Adornee = hrp
    bgui.Size = UDim2.fromOffset(100, 150)
    bgui.StudsOffset = Vector3.new(0, 1.5, 0)
    bgui.AlwaysOnTop = true
    bgui.Active = false
    bgui.ResetOnSpawn = false
    bgui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    -- Frame Principal
    local main = Instance.new("Frame", bgui)
    main.Name = "Main"
    main.Size = UDim2.fromScale(1, 1)
    main.BackgroundTransparency = 1
    main.BorderSizePixel = 0

    -- Função auxiliar para criar linhas
    local function makeLine(name, size, pos, rot)
        local l = Instance.new("Frame", main)
        l.Name = name
        l.Size = size
        l.Position = pos
        l.AnchorPoint = Vector2.new(0.5, 0.5)
        l.BackgroundColor3 = CFG.COLOR
        l.BorderSizePixel = 0
        if rot then l.Rotation = rot end
        return l
    end

    -- CABEÇA (Quadrado com borda)
    local head = Instance.new("Frame", main)
    head.Name = "Head"
    head.Size = UDim2.fromOffset(16, 16)
    head.Position = UDim2.fromScale(0.5, 0.2)
    head.AnchorPoint = Vector2.new(0.5, 0.5)
    head.BackgroundColor3 = Color3.new(0,0,0)
    head.BorderSizePixel = 0
    local headStroke = Instance.new("UIStroke", head)
    headStroke.Color = CFG.COLOR
    headStroke.Thickness = CFG.LINE_THICKNESS

    -- TORSO (Linha vertical central)
    makeLine("Torso", UDim2.fromOffset(CFG.LINE_THICKNESS, 50), UDim2.fromScale(0.5, 0.5))
    
    -- BRAÇO ESQUERDO (Diagonal)
    makeLine("LeftArm", UDim2.fromOffset(CFG.LINE_THICKNESS, 35), UDim2.fromScale(0.35, 0.4), 30)
    -- BRAÇO DIREITO (Diagonal)
    makeLine("RightArm", UDim2.fromOffset(CFG.LINE_THICKNESS, 35), UDim2.fromScale(0.65, 0.4), -30)
    
    -- Perna ESQUERDA (Diagonal)
    makeLine("LeftLeg", UDim2.fromOffset(CFG.LINE_THICKNESS, 45), UDim2.fromScale(0.4, 0.75), 15)
    -- PERNA DIREITA (Diagonal)
    makeLine("RightLeg", UDim2.fromOffset(CFG.LINE_THICKNESS, 45), UDim2.fromScale(0.6, 0.75), -15)

    -- NOME (Opcional)
    if CFG.SHOW_NAME then
        local nameLabel = Instance.new("TextLabel", main)
        nameLabel.Name = "NameLabel"
        nameLabel.Size = UDim2.fromScale(1, 0.1)
        nameLabel.Position = UDim2.fromScale(0, -0.1)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = player.Name
        nameLabel.TextColor3 = Color3.new(1, 1, 1)
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = 12
    end

    activeBillboards[player.Name] = bgui
    return bgui
end

local function removeStickman(playerName)
    local bgui = activeBillboards[playerName]
    if bgui then
        bgui:Destroy()
        activeBillboards[playerName] = nil
    end
end

-- ==========================================
-- LOOP PRINCIPAL (Renderização)
-- ==========================================
RunService.RenderStepped:Connect(function()
    local camPos = Camera.CFrame.Position
    local visiblePlayers = {}

    -- 1. Identificar quem deve ser mostrado
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character then continue end
        if isFriendly(player.Character) then
            removeStickman(player.Name)
            continue
        end

        local hrp = getHRP(player.Character)
        if not hrp then continue end

        local dist = (camPos - hrp.Position).Magnitude
        if dist <= CFG.MAX_DIST then
            table.insert(visiblePlayers, player)
        else
            removeStickman(player.Name)
        end
    end

    -- 2. Criar/Atualizar Billboards
    for _, player in ipairs(visiblePlayers) do
        if not activeBillboards[player.Name] then
            createStickman(player)
        else
            -- Garante que está visível (caso tenha sido desativado)
            activeBillboards[player.Name].Enabled = true
        end
    end
end)

-- Limpeza ao sair do jogo
game:BindToClose(function()
    for _, bgui in pairs(activeBillboards) do
        bgui:Destroy()
    end
end)

print("[Stickman ESP] Ativo. Verifique os inimigos ao seu redor.")
