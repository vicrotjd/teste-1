-- Nexus Stickman ESP + Panel
-- Personalizável: Tamanho, Espessura, Hitbox, Toggles

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- ==========================================
-- CONFIG (Editável via Painel)
-- ==========================================
local CFG = {
    AIM_KEY = Enum.KeyCode.C,
    SMOOTHING = 0.15,
    MAX_DIST = 400,
    ESP_COLOR = Color3.fromRGB(0, 255, 128),
    TARGET_COLOR = Color3.fromRGB(255, 50, 50),
    ENABLE_ESP = true,
    ENABLE_AIMBOT = true,
    SHOW_NAMES = true,
    USE_HITBOX = true, -- Se true, Aimbot mira no centro da hitbox
    STICKMAN_SCALE = 1.0, -- Escala do boneco (1.0 = padrão)
    LINE_THICKNESS = 3,   -- Espessura das linhas
    MAX_ESP_OBJECTS = 20
}

local state = {
    aiming = false,
    target = nil,
    billboards = {},
    uiCreated = false
}

-- ==========================================
-- UTILITÁRIOS
-- ==========================================
local function getHRP(model)
    if not model or not model:IsA("Model") then return nil end
    return model:FindFirstChild("HumanoidRootPart")
end

local function isFriendly(model)
    if model == LocalPlayer.Character then return true end
    local team = model:FindFirstChildOfClass("Team")
    if team and team.Team == LocalPlayer.Team then return true end
    return false
end

-- Retorna o ponto de mira (Head ou HRP)
local function getAimPoint(model)
    if CFG.USE_HITBOX then
        local head = model:FindFirstChild("Head")
        if head then return head.Position end
    end
    return getHRP(model).Position
end

-- ==========================================
-- ESP: BONECO PALITO OTIMIZADO
-- ==========================================
local function createStickman(player)
    if state.billboards[player.Name] then
        return state.billboards[player.Name]
    end

    local char = player.Character
    if not char then return nil end
    local hrp = getHRP(char)
    if not hrp then return nil end

    local bgui = Instance.new("BillboardGui")
    bgui.Name = "StickmanESP_" .. player.Name
    bgui.Adornee = hrp
    bgui.Size = UDim2.fromOffset(100, 150) * CFG.STICKMAN_SCALE
    bgui.StudsOffset = Vector3.new(0, 1.5, 0)
    bgui.AlwaysOnTop = true
    bgui.Active = false
    bgui.ResetOnSpawn = false
    bgui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local main = Instance.new("Frame", bgui)
    main.Name = "Main"
    main.Size = UDim2.fromScale(1, 1)
    main.BackgroundTransparency = 1
    main.BorderSizePixel = 0

    local function makeLine(name, size, pos, rot)
        local l = Instance.new("Frame", main)
        l.Name = name
        l.Size = size
        l.Position = pos
        l.AnchorPoint = Vector2.new(0.5, 0.5)
        l.BackgroundColor3 = CFG.ESP_COLOR
        l.BorderSizePixel = 0
        if rot then l.Rotation = rot end
        return l
    end

    -- CABEÇA (Quadrado)
    local head = Instance.new("Frame", main)
    head.Name = "Head"
    head.Size = UDim2.fromOffset(16, 16)
    head.Position = UDim2.fromScale(0.5, 0.2)
    head.AnchorPoint = Vector2.new(0.5, 0.5)
    head.BackgroundColor3 = Color3.new(0,0,0)
    head.BorderSizePixel = 0
    local headStroke = Instance.new("UIStroke", head)
    headStroke.Color = CFG.ESP_COLOR
    headStroke.Thickness = CFG.LINE_THICKNESS

    -- TORSO (Linha Vertical Central)
    makeLine("Torso", UDim2.fromOffset(CFG.LINE_THICKNESS, 50), UDim2.fromScale(0.5, 0.5))
    
    -- BRAÇO ESQUERDO
    makeLine("LeftArm", UDim2.fromOffset(CFG.LINE_THICKNESS, 35), UDim2.fromScale(0.35, 0.4), 30)
    -- BRAÇO DIREITO
    makeLine("RightArm", UDim2.fromOffset(CFG.LINE_THICKNESS, 35), UDim2.fromScale(0.65, 0.4), -30)
    
    -- PERNA ESQUERDA
    makeLine("LeftLeg", UDim2.fromOffset(CFG.LINE_THICKNESS, 45), UDim2.fromScale(0.4, 0.75), 15)
    -- PERNA DIREITA
    makeLine("RightLeg", UDim2.fromOffset(CFG.LINE_THICKNESS, 45), UDim2.fromScale(0.6, 0.75), -15)

    -- NOME
    if CFG.SHOW_NAMES then
        local nameLabel = Instance.new("TextLabel", main)
        nameLabel.Name = "NameLabel"
        nameLabel.Size = UDim2.fromScale(1, 0.1)
        nameLabel.Position = UDim2.fromScale(0, -0.1)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = player.Name
        nameLabel.TextColor3 = Color3.new(1, 1, 1)
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = 12
    end

    state.billboards[player.Name] = bgui
    return bgui
end

local function removeStickman(playerName)
    local bgui = state.billboards[playerName]
    if bgui then
        bgui:Destroy()
        state.billboards[playerName] = nil
    end
end

local function updateESP()
    if not CFG.ENABLE_ESP then
        for _, bgui in pairs(state.billboards) do
            bgui.Enabled = false
        end
        return
    end

    local camPos = Camera.CFrame.Position
    local visiblePlayers = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character then continue end
        if isFriendly(player.Character) then
            removeStickman(player.Name)
            continue
        end

        local hrp = getHRP(player.Character)
        if not hrp then continue end

        local dist = (camPos - hrp.Position).Magnitude
        if dist <= CFG.MAX_DIST then
            table.insert(visiblePlayers, player)
        else
            removeStickman(player.Name)
        end
    end

    -- Limite
    if #visiblePlayers > CFG.MAX_ESP_OBJECTS then
        table.sort(visiblePlayers, function(a, b)
            local aHRP = getHRP(a.Character)
            local bHRP = getHRP(b.Character)
            if not aHRP or not bHRP then return true end
            return (camPos - aHRP.Position).Magnitude > (camPos - bHRP.Position).Magnitude
        end)
        for i = CFG.MAX_ESP_OBJECTS + 1, #visiblePlayers do
            removeStickman(visiblePlayers[i].Name)
        end
    end

    for _, player in ipairs(visiblePlayers) do
        if not state.billboards[player.Name] then
            createStickman(player)
        else
            local bgui = state.billboards[player.Name]
            bgui.Enabled = true
            -- Atualiza cor se for alvo
            local head = bgui:FindFirstChild("Main"):FindFirstChild("Head")
            if head then
                local stroke = head:FindFirstChildOfClass("UIStroke")
                if stroke then
                    stroke.Color = (state.target and state.target.model == player) and CFG.TARGET_COLOR or CFG.ESP_COLOR
                end
            end
        end
    end
end

-- ==========================================
-- AIMBOT
-- ==========================================
local function getTarget()
    local best = nil
    local bestScore = -math.huge
    local camPos = Camera.CFrame.Position
    local lookVec = Camera.CFrame.LookVector

    if not (camPos and lookVec) then return nil end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character then continue end
        if isFriendly(player.Character) then continue end

        local hrp = getHRP(player.Character)
        if not hrp then continue end

        local dist = (camPos - hrp.Position).Magnitude
        if dist > CFG.MAX_DIST or dist == 0 then continue end

        local dir = (hrp.Position - camPos).Unit
        local dot = lookVec:Dot(dir)

        if dot > 0.9 then
            local score = dot - (dist / 1000)
            if score > bestScore then
                bestScore = score
                best = { model = player, hrp = hrp, pos = hrp.Position, dist = dist }
            end
        end
    end
    return best
end

local function applyAimbot()
    if not (CFG.ENABLE_AIMBOT and state.aiming) then
        state.target = nil
        return
    end

    local target = getTarget()
    state.target = target

    if target then
        local camCF = Camera.CFrame
        if not camCF:IsA("CFrame") or camCF.Position:Dot(Vector3.one) == 0 then return end
        
        -- Usa o ponto de mira configurado (Head ou HRP)
        local targetPos = getAimPoint(target.model.Character)
        local targetDir = (targetPos - camCF.Position)
        if targetDir.Magnitude < 0.1 then return end
        
        local desiredLook = targetDir.Unit
        local currentLook = camCF.LookVector
        local newLook = currentLook:Lerp(desiredLook, CFG.SMOOTHING)
        
        if newLook:Dot(Vector3.one) == 0 then return end

        Camera.CFrame = CFrame.lookAt(camCF.Position, camCF.Position + newLook)
    end
end

