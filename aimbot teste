local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- ==========================================
-- CONFIGURAÇÕES (Editáveis via UI)
-- ==========================================
local CFG = {
    AIM_KEY = Enum.KeyCode.C,
    SMOOTHING = 0.15,
    MAX_DIST = 400,
    ESP_COLOR = Color3.fromRGB(0, 255, 128),
    TARGET_COLOR = Color3.fromRGB(255, 0, 0),
    FOV_RADIUS = 100,
    SHOW_NAMES = true,
    ENABLE_ESP = true,
    ENABLE_AIMBOT = true,
    ENABLE_FOV = true,
    MAX_ESP_OBJECTS = 50
}

local state = {
    aiming = false,
    target = nil,
    uiOpen = true
}

-- ==========================================
-- LÓGICA DE ESP/AIMBOT
-- ==========================================
local function getHRP(model)
    if not model or not model:IsA("Model") then return nil end
    local hrp = model:FindFirstChild("HumanoidRootPart")
    return (hrp and hrp:IsA("BasePart")) and hrp or nil
end

local function W2S(pos)
    if not Camera or not pos then return Vector2.new(0,0), false end
    local success, screenPos, onScreen = pcall(function()
        return Camera:WorldToViewportPoint(pos)
    end)
    if not success then return Vector2.new(0,0), false end
    return screenPos, onScreen
end

local function isFriendly(model)
    if model == LocalPlayer.Character then return true end
    local team = model:FindFirstChildOfClass("Team")
    if team and team.Team == LocalPlayer.Team then return true end
    return false
end

local function getTarget()
    local best = nil
    local bestScore = -math.huge
    local camPos = Camera.CFrame.Position
    local lookVec = Camera.CFrame.LookVector

    if not (camPos and lookVec) then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char or isFriendly(char) then continue end

        local hrp = getHRP(char)
        if not hrp then continue end

        local dist = (camPos - hrp.Position).Magnitude
        if dist > CFG.MAX_DIST or dist == 0 then continue end

        local dir = (hrp.Position - camPos).Unit
        local dot = lookVec:Dot(dir)

        if dot > 0.9 then
            local score = dot - (dist / 1000)
            if score > bestScore then
                bestScore = score
                best = { model = plr, hrp = hrp, pos = hrp.Position, dist = dist }
            end
        end
    end
    return best
end

local function renderESP()
    if not CFG.ENABLE_ESP then return end
    local objects = {}
    local camPos = Camera.CFrame.Position
    local vpSize = Camera.ViewportSize
    if vpSize.X <= 0 or vpSize.Y <= 0 then return end

    if CFG.ENABLE_FOV then
        table.insert(objects, {
            Position = Vector2.new(vpSize.X / 2, vpSize.Y / 2),
            Size = Vector2.new(CFG.FOV_RADIUS, CFG.FOV_RADIUS),
            Thickness = 2,
            Color = Color3.new(1, 1, 1),
            Filled = false,
            Visible = true
        })
    end

    local count = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if count >= CFG.MAX_ESP_OBJECTS then break end
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char or isFriendly(char) then continue end

        local hrp = getHRP(char)
        if not hrp then continue end

        local screenPos, onScreen = W2S(hrp.Position)
        if not onScreen then continue end

        local dist = (camPos - hrp.Position).Magnitude
        local size = math.clamp(40 / dist, 10, 60)
        local color = CFG.ESP_COLOR
        if state.target and state.target.model == plr then
            color = CFG.TARGET_COLOR
        end

        table.insert(objects, {
            Position = Vector2.new(screenPos.X, screenPos.Y),
            Size = Vector2.new(size, size),
            Thickness = 2,
            Color = color,
            Filled = false,
            Visible = true
        })

        if CFG.SHOW_NAMES and dist < 200 then
            table.insert(objects, {
                Text = plr.Name,
                Color = Color3.new(1, 1, 1),
                BackgroundColor3 = Color3.new(0, 0, 0),
                BackgroundTransparency = 0.6,
                Position = Vector2.new(screenPos.X, screenPos.Y - size),
                Size = Vector2.new(0, 0),
                Visible = true
            })
        end
        count += 1
    end

    if #objects > 0 then
        pcall(function() Camera:DrawToScreen(objects) end)
    end
end

local function applyAimbot()
    if not (CFG.ENABLE_AIMBOT and state.aiming) then
        state.target = nil
        return
    end

    local target = getTarget()
    state.target = target

    if target then
        local camCF = Camera.CFrame
        if not camCF:IsA("CFrame") or camCF.Position:Dot(Vector3.one) == 0 then return end
        
        local targetPos = target.pos
        local targetDir = (targetPos - camCF.Position)
        if targetDir.Magnitude < 0.1 then return end
        
        local desiredLook = targetDir.Unit
        local currentLook = camCF.LookVector
        local newLook = currentLook:Lerp(desiredLook, CFG.SMOOTHING)
        
        if newLook:Dot(Vector3.one) == 0 then return end

        Camera.CFrame = CFrame.lookAt(camCF.Position, camCF.Position + newLook)
    end
end

