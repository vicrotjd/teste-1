-- Nexus ESP v3: Native Universal (No DrawToScreen)
-- Funciona em qualquer jogo Roblox, sem APIs proprietárias.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- ==========================================
-- CONFIGURAÇÕES
-- ==========================================
local CFG = {
    AIM_KEY = Enum.KeyCode.C,
    SMOOTHING = 0.15,
    MAX_DIST = 400,
    ESP_COLOR = Color3.fromRGB(0, 255, 128),
    TARGET_COLOR = Color3.fromRGB(255, 0, 0),
    ENABLE_ESP = true,
    ENABLE_AIMBOT = true,
    SHOW_NAMES = true,
    MAX_ESP_OBJECTS = 25 -- Limite de Billboards para performance
}

local state = {
    aiming = false,
    target = nil,
    activeBillboards = {} -- [Player] = BillboardGui
}

-- ==========================================
-- UTILITÁRIOS
-- ==========================================
local function getHRP(model)
    if not model or not model:IsA("Model") then return nil end
    local hrp = model:FindFirstChild("HumanoidRootPart")
    return (hrp and hrp:IsA("BasePart")) and hrp or nil
end

local function isFriendly(model)
    if model == LocalPlayer.Character then return true end
    local team = model:FindFirstChildOfClass("Team")
    if team and team.Team == LocalPlayer.Team then return true end
    return false
end

-- Cria ou atualiza um BillboardGui para um player
local function createBillboard(player)
    if state.activeBillboards[player] then
        return state.activeBillboards[player]
    end

    local bgui = Instance.new("BillboardGui")
    bgui.Name = "ESP_" .. player.Name
    bgui.Adornee = getHRP(player.Character) or player.Character:FindFirstChild("Head")
    bgui.Size = UDim2.fromOffset(200, 100)
    bgui.StudsOffset = Vector3.new(0, 1, 0)
    bgui.AlwaysOnTop = true
    bgui.Active = false
    bgui.ResetOnSpawn = false
    bgui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame", bgui)
    frame.Name = "ESPFrame"
    frame.Size = UDim2.fromScale(1, 1)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0

    local corner = Instance.new("UICorner", frame)
    corner.CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = CFG.ESP_COLOR
    stroke.Thickness = 2
    stroke.Transparency = 0.2

    local nameLabel = Instance.new("TextLabel", frame)
    nameLabel.Name = "NameLabel"
    nameLabel.Size = UDim2.fromScale(1, 0.5)
    nameLabel.Position = UDim2.fromScale(0, -0.5)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.new(1, 1, 1)
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 16

    state.activeBillboards[player] = bgui
    return bgui
end

local function removeBillboard(player)
    local bgui = state.activeBillboards[player]
    if bgui then
        bgui:Destroy()
        state.activeBillboards[player] = nil
    end
end

-- Limpa Billboards de players que saíram ou ficaram fora do alcance
local function cleanupBillboards()
    for player, bgui in pairs(state.activeBillboards) do
        local shouldRemove = false
        if not player.Character then
            shouldRemove = true
        elseif isFriendly(player.Character) then
            shouldRemove = true
        else
            local hrp = getHRP(player.Character)
            if hrp then
                local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
                if dist > CFG.MAX_DIST then
                    shouldRemove = true
                end
            end
        end
        
        if shouldRemove then
            removeBillboard(player)
        end
    end
end

-- ==========================================
-- LÓGICA PRINCIPAL
-- ==========================================
local function updateESP()
    if not CFG.ENABLE_ESP then
        for _, bgui in pairs(state.activeBillboards) do
            bgui.Enabled = false
        end
        return
    end

    local camPos = Camera.CFrame.Position
    local count = 0

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character then continue end
        if isFriendly(player.Character) then
            removeBillboard(player)
            continue
        end

        local hrp = getHRP(player.Character)
        if not hrp then continue end

        local dist = (camPos - hrp.Position).Magnitude
        if dist > CFG.MAX_DIST then
            removeBillboard(player)
            continue
        end

        -- Limita a quantidade de Billboards ativos
        if count >= CFG.MAX_ESP_OBJECTS then
            if not state.activeBillboards[player] then continue end
        else
            count += 1
        end

        local bgui = createBillboard(player)
        bgui.Enabled = true
        
        -- Atualiza cor se for o alvo do Aimbot
        local stroke = bgui:FindFirstChild("ESPFrame"):FindFirstChild("UIStroke")
        if stroke then
            if state.target and state.target.model == player then
                stroke.Color = CFG.TARGET_COLOR
            else
                stroke.Color = CFG.ESP_COLOR
            end
        end
        
        -- Esconde nome se configurado
        local nameLabel = bgui:FindFirstChild("ESPFrame"):FindFirstChild("NameLabel")
        if nameLabel then
            nameLabel.Visible = CFG.SHOW_NAMES
        end
    end

    cleanupBillboards()
end

local function getTarget()
    local best = nil
    local bestScore = -math.huge
    local camPos = Camera.CFrame.Position
    local lookVec = Camera.CFrame.LookVector

    if not (camPos and lookVec) then return nil end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character then continue end
        if isFriendly(player.Character) then continue end

        local hrp = getHRP(player.Character)
        if not hrp then continue end

        local dist = (camPos - hrp.Position).Magnitude
        if dist > CFG.MAX_DIST or dist == 0 then continue end

        local dir = (hrp.Position - camPos).Unit
        local dot = lookVec:Dot(dir)

        if dot > 0.9 then
            local score = dot - (dist / 1000)
            if score > bestScore then
                bestScore = score
                best = { model = player, hrp = hrp, pos = hrp.Position, dist = dist }
            end
        end
    end
    return best
end

local function applyAimbot()
    if not (CFG.ENABLE_AIMBOT and state.aiming) then
        state.target = nil
        return
    end

    local target = getTarget()
    state.target = target

    if target then
        local camCF = Camera.CFrame
        if not camCF:IsA("CFrame") or camCF.Position:Dot(Vector3.one) == 0 then return end
        
        local targetPos = target.pos
        local targetDir = (targetPos - camCF.Position)
        if targetDir.Magnitude < 0.1 then return end
        
        local desiredLook = targetDir.Unit
        local currentLook = camCF.LookVector
        local newLook = currentLook:Lerp(desiredLook, CFG.SMOOTHING)
        
        if newLook:Dot(Vector3.one) == 0 then return end

        Camera.CFrame = CFrame.lookAt(camCF.Position, camCF.Position + newLook)
    end
end

-- ==========================================
-- INPUT
-- ==========================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == CFG.AIM_KEY then
        state.aiming = true
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if input.KeyCode == CFG.AIM_KEY then
        state.aiming = false
    end
end)

-- ==========================================
-- LOOP PRINCIPAL
-- ==========================================
RunService.RenderStepped:Connect(function()
    updateESP()
    applyAimbot()
end)

-- Limpeza ao sair
game:BindToClose(function()
    for _, bgui in pairs(state.activeBillboards) do
        bgui:Destroy()
    end
end)

print("[Nexus ESP v3] Ativo. Segure " .. CFG.AIM_KEY.Name .. " para mirar.")
