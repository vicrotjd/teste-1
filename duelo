local charRef, rootRef, humRef
local function getChar()
    charRef = lp.Character or lp.CharacterAdded:Wait()
    rootRef = charRef:WaitForChild("HumanoidRootPart")
    humRef  = charRef:WaitForChild("Humanoid")
end
getChar()
lp.CharacterAdded:Connect(getChar)

UserInputService.JumpRequest:Connect(function()
    if cfg.movement.infjump and humRef then
        humRef:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

RunService.Stepped:Connect(function()
    if cfg.movement.noclip and charRef then
        for _,p in ipairs(charRef:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide=false end
        end
    end
end)

local flyConn, flyBP, flyBA
function handleFly(on)
    if on then
        if flyConn then flyConn:Disconnect() end
        flyBP = Instance.new("BodyVelocity", rootRef)
        flyBP.MaxForce = Vector3.new(1e9,1e9,1e9); flyBP.Velocity=Vector3.zero
        flyBA = Instance.new("BodyAngularVelocity", rootRef)
        flyBA.MaxTorque=Vector3.new(1e9,1e9,1e9); flyBA.AngularVelocity=Vector3.zero
        humRef:ChangeState(Enum.HumanoidStateType.Physics)
        flyConn = RunService.Heartbeat:Connect(function()
            if not cfg.movement.fly then
                pcall(function()flyBP:Destroy()end); pcall(function()flyBA:Destroy()end)
                flyConn:Disconnect(); humRef:ChangeState(Enum.HumanoidStateType.GettingUp); return
            end
            local c=workspace.CurrentCamera; local dir=Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir=dir+c.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir=dir-c.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir=dir-c.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir=dir+c.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space)     then dir=dir+Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir=dir-Vector3.new(0,1,0) end
            flyBP.Velocity = dir.Magnitude>0 and dir.Unit*cfg.movement.flyVal or Vector3.zero
        end)
    else
        if flyConn then flyConn:Disconnect() end
        pcall(function()flyBP:Destroy()end); pcall(function()flyBA:Destroy()end)
        if humRef then humRef:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end
end

