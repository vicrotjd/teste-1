--  SKELETON / ESP BONES
-- ══════════════════════════════════════════════════════════════
local BONES = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
}

local function w2s(pos)
    local sp, vis = cam:WorldToViewportPoint(pos)
    return Vector2.new(sp.X, sp.Y), vis, sp.Z
end

local espObjects = {}

local function newDraw(t, props)
    local d = Drawing.new(t)
    for k,v in pairs(props) do d[k]=v end
    return d
end

local function buildPool(player)
    local obj = { box={}, skel={}, tracer=nil, hbar={}, name=nil, dist=nil }
    for i=1,4 do
        obj.box[i] = newDraw("Line",{Visible=false,Color=cfg.esp.colors.box,Thickness=1})
    end
    for i=1,#BONES do
        obj.skel[i] = newDraw("Line",{Visible=false,Color=cfg.esp.colors.skeleton,Thickness=1})
    end
    obj.tracer = newDraw("Line",{Visible=false,Color=cfg.esp.colors.tracer,Thickness=1})
    obj.hbar.bg  = newDraw("Line",{Visible=false,Color=Color3.fromRGB(0,0,0),Thickness=4})
    obj.hbar.fill= newDraw("Line",{Visible=false,Color=cfg.esp.colors.healthOn,Thickness=3})
    obj.name = newDraw("Text",{Visible=false,Color=cfg.esp.colors.name,Size=13,Center=true,Outline=true,OutlineColor=Color3.new(0,0,0),Text=player.Name,Font=2})
    obj.dist = newDraw("Text",{Visible=false,Color=cfg.esp.colors.dist,Size=11,Center=true,Outline=true,OutlineColor=Color3.new(0,0,0),Font=2})
    espObjects[player] = obj
end

local function removePool(player)
    if not espObjects[player] then return end
    local obj = espObjects[player]
    for _,l in ipairs(obj.box)  do pcall(function()l:Remove()end) end
    for _,l in ipairs(obj.skel) do pcall(function()l:Remove()end) end
    pcall(function()obj.tracer:Remove()end)
    pcall(function()obj.hbar.bg:Remove()end)
    pcall(function()obj.hbar.fill:Remove()end)
    pcall(function()obj.name:Remove()end)
    pcall(function()obj.dist:Remove()end)
    espObjects[player] = nil
end

for _,p in ipairs(Players:GetPlayers()) do if p~=lp then buildPool(p) end end
Players.PlayerAdded:Connect(function(p) if p~=lp then buildPool(p) end end)
Players.PlayerRemoving:Connect(removePool)

local function drawBox4(lines, tl, tr, br, bl)
    local c = {tl,tr,br,bl,tl}
    for i=1,4 do lines[i].From=c[i]; lines[i].To=c[i+1]; lines[i].Visible=true end
end
local function hideLines(t) for _,l in ipairs(t) do l.Visible=false end end

-- ══════════════════════════════════════════════════════════════
--  ESP RENDER LOOP
-- ══════════════════════════════════════════════════════════════
local vp = cam.ViewportSize
RunService.RenderStepped:Connect(function()
    vp = cam.ViewportSize
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")

    for player, obj in pairs(espObjects) do
        local char = player.Character
        local function hide()
            hideLines(obj.box); hideLines(obj.skel)
            obj.tracer.Visible=false; obj.hbar.bg.Visible=false
            obj.hbar.fill.Visible=false; obj.name.Visible=false; obj.dist.Visible=false
        end

        if not cfg.esp.enabled or not char then hide() continue end

        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not root or not head or not hum or hum.Health<=0 then hide() continue end
        if cfg.esp.teamCheck and player.Team==lp.Team then hide() continue end

        local dist = myRoot and (root.Position-myRoot.Position).Magnitude or 0
        if dist > cfg.esp.maxDist then hide() continue end

        local _, hv, hz = w2s(head.Position)
        if not hv or hz<0 then hide() continue end

        local top2d = w2s(head.Position+Vector3.new(0,0.7,0))
        local bot2d = w2s(root.Position-Vector3.new(0,3,0))
        local height = math.abs(top2d.Y - bot2d.Y)
        local width  = height * 0.5

        -- box
        if cfg.esp.box then
            drawBox4(obj.box,
                Vector2.new(top2d.X-width, top2d.Y),
                Vector2.new(top2d.X+width, top2d.Y),
                Vector2.new(top2d.X+width, bot2d.Y),
                Vector2.new(top2d.X-width, bot2d.Y))
        else hideLines(obj.box) end

        -- skeleton
        if cfg.esp.skeleton then
            for i, pair in ipairs(BONES) do
                local p0=char:FindFirstChild(pair[1]); local p1=char:FindFirstChild(pair[2])
                if p0 and p1 then
                    local s0,v0=w2s(p0.Position); local s1,v1=w2s(p1.Position)
                    obj.skel[i].From=s0; obj.skel[i].To=s1; obj.skel[i].Visible=v0 and v1
                else obj.skel[i].Visible=false end
            end
        else hideLines(obj.skel) end

        -- tracer
        if cfg.esp.tracer then
            obj.tracer.From    = Vector2.new(vp.X/2, vp.Y)
            obj.tracer.To      = Vector2.new(top2d.X, bot2d.Y)
            obj.tracer.Visible = true
        else obj.tracer.Visible=false end

        -- health bar
        if cfg.esp.healthbar then
            local hp   = hum.Health/hum.MaxHealth
            local barX = top2d.X - width - 5
            local hColor = Color3.fromRGB(
                math.floor((1-hp)*255), math.floor(hp*255), 50)
            obj.hbar.bg.From   = Vector2.new(barX, top2d.Y)
            obj.hbar.bg.To     = Vector2.new(barX, bot2d.Y)
            obj.hbar.bg.Visible= true
            obj.hbar.fill.From = Vector2.new(barX, bot2d.Y)
            obj.hbar.fill.To   = Vector2.new(barX, bot2d.Y - height*hp)
            obj.hbar.fill.Color= hColor
            obj.hbar.fill.Visible=true
        else obj.hbar.bg.Visible=false; obj.hbar.fill.Visible=false end

        -- name
        if cfg.esp.name then
            local np = w2s(head.Position+Vector3.new(0,1.2,0))
            obj.name.Position=np-Vector2.new(0,16); obj.name.Visible=true
        else obj.name.Visible=false end

        -- distance
        if cfg.esp.distance then
            obj.dist.Text    = string.format("[%.0fm]",dist)
            obj.dist.Position= bot2d+Vector2.new(0,4)
            obj.dist.Visible = true
        else obj.dist.Visible=false end
    end
end)

