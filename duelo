local function toggle(parent, txt, order, callback)
    local row = make("Frame",{
        Size=UDim2.new(1,0,0,26),
        BackgroundTransparency=1,
        LayoutOrder=order,
    },parent)

    make("TextLabel",{
        Text=txt, TextSize=12, Font=Enum.Font.Gotham,
        TextColor3=T.text, BackgroundTransparency=1,
        Size=UDim2.new(1,-44,1,0),
        TextXAlignment=Enum.TextXAlignment.Left,
    },row)

    local pill = make("Frame",{
        Size=UDim2.new(0,38,0,20),
        Position=UDim2.new(1,-38,0.5,-10),
        BackgroundColor3=T.off,
        BorderSizePixel=0,
    },row)
    make("UICorner",{CornerRadius=UDim.new(1,0)},pill)

    local knob = make("Frame",{
        Size=UDim2.new(0,14,0,14),
        Position=UDim2.new(0,3,0.5,-7),
        BackgroundColor3=Color3.new(1,1,1),
        BorderSizePixel=0,
    },pill)
    make("UICorner",{CornerRadius=UDim.new(1,0)},knob)

    local btn = make("TextButton",{
        Text="", BackgroundTransparency=1,
        Size=UDim2.new(1,0,1,0),
    },row)

    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        local color = state and T.on or T.off
        local kpos  = state and UDim2.new(1,-17,0.5,-7) or UDim2.new(0,3,0.5,-7)
        TweenService:Create(pill, TweenInfo.new(0.15),{BackgroundColor3=color}):Play()
        TweenService:Create(knob, TweenInfo.new(0.15),{Position=kpos}):Play()
        callback(state)
    end)

    -- expose setter
    return function(val)
        state = val
        local color = state and T.on or T.off
        local kpos  = state and UDim2.new(1,-17,0.5,-7) or UDim2.new(0,3,0.5,-7)
        pill.BackgroundColor3 = color
        knob.Position = kpos
        callback(state)
    end
end

local function slider(parent, txt, min, max, default, order, callback)
    local row = make("Frame",{
        Size=UDim2.new(1,0,0,42),
        BackgroundTransparency=1,
        LayoutOrder=order,
    },parent)

    local valLabel = make("TextLabel",{
        Text=txt..": "..default,
        TextSize=11, Font=Enum.Font.Gotham,
        TextColor3=T.sub, BackgroundTransparency=1,
        Size=UDim2.new(1,0,0,16),
        TextXAlignment=Enum.TextXAlignment.Left,
    },row)

    local track = make("Frame",{
        Size=UDim2.new(1,0,0,6),
        Position=UDim2.new(0,0,0,22),
        BackgroundColor3=T.slider,
        BorderSizePixel=0,
    },row)
    make("UICorner",{CornerRadius=UDim.new(1,0)},track)

    local fill = make("Frame",{
        Size=UDim2.new((default-min)/(max-min),0,1,0),
        BackgroundColor3=T.accent,
        BorderSizePixel=0,
    },track)
    make("UICorner",{CornerRadius=UDim.new(1,0)},fill)

    local dragging = false
    local function update(x)
        local abs = track.AbsolutePosition.X
        local w   = track.AbsoluteSize.X
        local t   = math.clamp((x - abs)/w, 0, 1)
        local val = math.floor(min + t*(max-min))
        fill.Size = UDim2.new(t,0,1,0)
        valLabel.Text = txt..": "..val
        callback(val)
    end

    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; update(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            update(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
end

local function dropdown(parent, txt, options, default, order, callback)
    local open = false
    local current = default

    local wrap = make("Frame",{
        Size=UDim2.new(1,0,0,26),
        BackgroundTransparency=1,
        LayoutOrder=order,
        AutomaticSize=Enum.AutomaticSize.Y,
    },parent)
    make("UIListLayout",{SortOrder=Enum.SortOrder.LayoutOrder},wrap)

    local header = make("Frame",{
        Size=UDim2.new(1,0,0,26),
        BackgroundColor3=T.slider,
        BorderSizePixel=0,
        LayoutOrder=0,
    },wrap)
    make("UICorner",{CornerRadius=UDim.new(0,5)},header)

    make("TextLabel",{
        Text=txt..": "..current,
        TextSize=11, Font=Enum.Font.Gotham,
        TextColor3=T.text, BackgroundTransparency=1,
        Size=UDim2.new(1,-24,1,0),
        Position=UDim2.new(0,8,0,0),
        TextXAlignment=Enum.TextXAlignment.Left,
    },header)

    local arrow = make("TextLabel",{
        Text="▾", TextSize=12, Font=Enum.Font.GothamBold,
        TextColor3=T.accent, BackgroundTransparency=1,
        Size=UDim2.new(0,20,1,0),
        Position=UDim2.new(1,-22,0,0),
    },header)

    local hdrLabel = header:FindFirstChildWhichIsA("TextLabel")

    local hdrBtn = make("TextButton",{
        Text="", BackgroundTransparency=1,
        Size=UDim2.new(1,0,1,0),
    },header)

    local dropdown_frame = make("Frame",{
        Size=UDim2.new(1,0,0,#options*24),
        BackgroundColor3=T.section,
        BorderSizePixel=0,
        Visible=false,
        LayoutOrder=1,
        ZIndex=10,
    },wrap)
    make("UICorner",{CornerRadius=UDim.new(0,5)},dropdown_frame)
    make("UIListLayout",{SortOrder=Enum.SortOrder.LayoutOrder},dropdown_frame)

    for i,opt in ipairs(options) do
        local ob = make("TextButton",{
            Text=opt, TextSize=11, Font=Enum.Font.Gotham,
            TextColor3=T.text, BackgroundTransparency=1,
            Size=UDim2.new(1,0,0,24),
            LayoutOrder=i,
        },dropdown_frame)
        ob.MouseButton1Click:Connect(function()
            current = opt
            hdrLabel.Text = txt..": "..current
            open = false
            dropdown_frame.Visible = false
            arrow.Text = "▾"
            callback(opt)
        end)
    end

    hdrBtn.MouseButton1Click:Connect(function()
        open = not open
        dropdown_frame.Visible = open
        arrow.Text = open and "▴" or "▾"
    end)
end

